def load_conf():
    c = json.loads(json.dumps(DEFAULT))
    if CONF_PATH.exists():
        user = json.loads(CONF_PATH.read_text())
        for k, v in user.items():
            c[k] = {**c[k], **v} if isinstance(c.get(k), dict) else v
    return c


def save_conf(**kv):
    """Change keys of the user's config file, after a dated backup of it."""
    raw = json.loads(CONF_PATH.read_text()) if CONF_PATH.exists() else {}
    if CONF_PATH.exists():
        shutil.copy2(CONF_PATH, CONF_PATH.with_name(f"config.json.bak-{time.strftime('%Y%m%d-%H%M%S')}"))
    raw.update(kv)
    CONF_PATH.parent.mkdir(parents=True, exist_ok=True)
    CONF_PATH.write_text(json.dumps(raw, indent=2, ensure_ascii=False))


def tilde(p):
    p, h = str(p), str(HOME)
    return "~" + p[len(h):] if p.startswith(h + "/") else p


def is_auto_cmd(cmd, allow):
    try:
        words = shlex.split(cmd)
    except ValueError:
        return False
    return bool(words) and words[0] in allow and not (set(cmd) & (META | GLOB))


class ServerError(Exception):
    """llama-server refused the request (HTTP error, error event) or the connection was lost."""


class SafeRedirect(urllib.request.HTTPRedirectHandler):
    """You approved one URL: a redirect may not switch to another scheme or to this phone or the local network."""
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        u = urllib.parse.urlsplit(newurl)
        try:
            local = u.hostname in (None, "localhost") or not ipaddress.ip_address(u.hostname).is_global
        except ValueError:
            local = False  # a name: resolved by the system, as for the approved URL
        if u.scheme not in ("http", "https") or local:
            raise urllib.error.URLError(f"redirect to {newurl} refused")
        return super().redirect_request(req, fp, code, msg, headers, newurl)


def plain(s):
    return CTRL.sub(lambda m: f"\\u{ord(m.group()):04x}", s)


def paths_ok(cmd, conf):
    """The arguments of an auto-allowed shell command stay where the file tools may look: `ls ~/.ssh` asks first."""
    for w in shlex.split(cmd)[1:]:
        if not w.startswith("-"):
            try:
                allowed(w, conf)
            except PermissionError:
                return False
    return True


def clip(s, n):
    return s if len(s) <= n else s[:n] + f"\n[... {len(s) - n} more characters cut]"


def workdir(conf):
    w = Path(conf["workdir"]).expanduser()
    w.mkdir(parents=True, exist_ok=True)
    return w


def target(path, conf):
    p = Path(path).expanduser()
    return p if p.is_absolute() else Path(conf["workdir"]).expanduser() / p


def allowed(path, conf):
    p = target(path, conf).resolve()
    inside = lambda r: p == r or r in p.parents
    for d in conf["denied_paths"]:
        if inside(Path(d).expanduser().resolve()):
            raise PermissionError(f"{p} is in a protected folder ({d})")
    hidden = False
    for root in conf["allowed_paths"]:
        r = Path(root).expanduser().resolve()
        if inside(r):
            # dotfiles hold credentials (.ssh, .netrc, .env) and code that runs by itself (.bashrc, .git/hooks):
            # reachable only below a root that names the hidden folder itself
            if not any(part.startswith(".") for part in p.relative_to(r).parts):
                return p
            hidden = True
    raise PermissionError(f"{p} is a hidden file or folder (protected)" if hidden
                          else f"{p} is outside the allowed folders {conf['allowed_paths']}")


def run(argv, timeout=300, cwd=None):
    # one stream, in the order printed (rish, Shizuku's shell, spreads its output between stdout and stderr at random)
    r = subprocess.run(argv, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, timeout=timeout, cwd=cwd,
                       stdin=subprocess.DEVNULL)
    return f"exit {r.returncode}\n{r.stdout}"


