def make_tools(conf):
    def t_read_file(path):
        p, n = allowed(path, conf), conf["max_tool_output"]
        with open(p, errors="replace") as f:  # a 4 GB video must not be read whole (Termux was killed for memory)
            text = f.read(n)
        size = p.stat().st_size
        return text if size <= n else text[:n - 200] + f"\n[... the file has {size:,} bytes: only its start was read]"

    def t_list_dir(path="."):
        return "\n".join(sorted(f"{x.name}/" if x.is_dir() else x.name for x in allowed(path, conf).iterdir()))

    def t_write_file(path, content):
        p = allowed(path, conf)
        p.parent.mkdir(parents=True, exist_ok=True)
        p.write_text(content)
        return f"wrote {len(content)} characters to {p}"

    def t_search(pattern, path="."):
        root = allowed(path, conf)
        argv = (["rg", "-n", "-S", "--max-count", "20", "--max-columns", "240", "-e", pattern, str(root)] if shutil.which("rg")
                else ["grep", "-rnI", "-m", "20", "--exclude-dir=.*", "-e", pattern, str(root)])
        out, keep = run(argv, timeout=60).split("\n", 1)[1].splitlines(), []
        for line in out:  # only hits in files the file tools may read (rg already skips hidden ones; denied folders too)
            try:
                allowed(line.split(":", 1)[0], conf)
                keep.append(line)
            except (PermissionError, OSError):
                pass
        return "\n".join(keep[:200]) or "no match"

    def t_git(args, repo="."):
        words, root = shlex.split(args), allowed(repo, conf)
        extra = ["--no-ext-diff", "--no-textconv"] if words[0] in ("diff", "show", "log") else []
        return run(["git", *GIT_SAFE, "-C", str(root), words[0], *extra, *words[1:]], timeout=180)

    def t_shell(command):
        return run(["bash", "-c", command], cwd=workdir(conf))

    def t_python(code):
        return run([sys.executable, "-c", code], cwd=workdir(conf))

    def t_fetch_url(url):
        if not url.startswith(("http://", "https://")):
            return "error: only http(s) URLs"
        opener = urllib.request.build_opener(SafeRedirect)
        with opener.open(urllib.request.Request(url, headers={"User-Agent": "seeker-ai"}), timeout=30) as r:
            body = r.read(2_000_000).decode(r.headers.get_content_charset() or "utf-8", "replace")
        body = re.sub(r"(?is)<(script|style).*?</\1>", " ", body)
        return html.unescape(re.sub(r"\s+", " ", re.sub(r"<[^>]+>", " ", body))).strip()

    def t_android(action, text="", title="", number="", path="", value="", package=""):
        if action == "open_url" and not text.startswith(("http://", "https://")):
            return "error: open_url needs an http(s) URL in text"
        if action == "install_apk" and not path.endswith(".apk"):
            return "error: install_apk needs the path of an .apk file"
        if action in ("screenshot", "photo") and not path:  # screencap runs as shell: it can write to shared storage only
            path = f"/sdcard/Pictures/seeker-ai-{int(time.time())}.{'png' if action == 'screenshot' else 'jpg'}"
        if action.startswith("app_"):
            if not PKG.fullmatch(package):
                return "error: package must be an Android package name, e.g. org.fossify.gallery"
            if action != "app_info" and (PROTECTED.search(package) or CORE.match(package)):
                return f"refused: {package} is protected (Seed Vault, Solana, Android core, Termux, Shizuku or the launcher)"
        a = {"text": text, "title": title, "number": number, "path": str(allowed(path, conf)) if path else "", "value": value,
             "package": package}
        build, _, backend = ANDROID[action]
        if backend == "api":
            return run(build(a), timeout=60)
        rish = rish_path()
        if not rish:
            return f"error: {action} needs Shizuku (start Shizuku, then run seeker-setup-shizuku)"
        out = run([rish, "-c", build(a)], timeout=120)
        if action in UNDO:  # every change is journaled with its undo, for you and for OPERATOR
            DATA.mkdir(parents=True, exist_ok=True)
            with open(DATA / "changes.tsv", "a") as f:
                f.write(f"{time.strftime('%F %T')}\t{action}\t{package}\tundo: {UNDO[action]}\t{out.splitlines()[0]}\n")
        return out

    def t_system(command):
        rish = rish_path()
        if not rish:
            return "error: Shizuku is not set up (no rish). Start Shizuku, then run seeker-setup-shizuku."
        return run([rish, "-c", command])

    def t_remember(note):
        note = re.sub(r"\s+", " ", CTRL.sub("", note)).strip()[:300]  # one plain line: a note goes into every later chat
        DATA.mkdir(parents=True, exist_ok=True)
        mem = DATA / "memory.md"
        known = {l.split(" ", 2)[-1].strip().lower() for l in mem.read_text().splitlines()} if mem.exists() else set()
        if note.strip().lower() in known:
            return "already noted"
        with open(mem, "a") as f:
            f.write(f"- {time.strftime('%Y-%m-%d')} {note.strip()}\n")
        return "noted"

    offered = offered_actions(conf)
    s = lambda **p: {"type": "object", "properties": {k: {"type": "string", "description": d} for k, d in p.items()}, "required": list(p)}
    android_schema = {"type": "object", "required": ["action"], "properties": {
        "action": {"type": "string", "enum": offered},
        "text": {"type": "string", "description": "message, or URL for open_url"},
        "title": {"type": "string"}, "number": {"type": "string", "description": "phone number for sms_send"},
        "path": {"type": "string", "description": "file: .apk for install_apk, .png for screenshot"},
        "value": {"type": "string", "description": "milliseconds for vibrate, on/off for torch, count for sms_list"},
        "package": {"type": "string", "description": "app package for app_info, app_stop, app_disable, app_enable"}}}
    return {
        "read_file": (t_read_file, "Read a text file", s(path="file path")),
        "list_dir": (t_list_dir, "List a directory", s(path="directory path")),
        "search": (t_search, "Find a text or regex in the files of a folder (file:line:text)", s(pattern="text or regex", path="folder")),
        "git": (t_git, "Run git in a repository: status, log, diff, show, add, commit, branch... (no options before the subcommand)",
                s(args="subcommand and its arguments, e.g. 'log --oneline -5'", repo="repository folder")),
        "write_file": (t_write_file, "Create or overwrite a text file", s(path="file path", content="full new content")),
        "shell": (t_shell, "Run a bash command in Termux (git, python, ls...), as the Termux app user, not root", s(command="the command")),
        "python": (t_python, "Run a Python 3 snippet and return what it prints", s(code="python code")),
        "fetch_url": (t_fetch_url, "Download a web page and return its text (uses the network)", s(url="http(s) URL")),
        "android": (t_android, "Phone features: " + ", ".join(offered), android_schema),
        "system": (t_system, "Run an Android shell command with ADB-level rights through Shizuku (pm, settings, dumpsys, getprop...)",
                   s(command="the command")),
        "remember": (t_remember, "Save a short note to long-term memory", s(note="what to remember")),
    }


def tool_specs(conf, tools):
    return [{"type": "function", "function": {"name": n, "description": d, "parameters": s}}
            for n, (_, d, s) in tools.items() if (offered_actions(conf) if n == "android" else policy(conf, n) != "off")]


def confirm(prompt):
    sys.stderr.write(f"{prompt} [y/N] ")
    sys.stderr.flush()
    forced = os.environ.get("SEEKER_AI_CONFIRM")  # scripted runs and tests: yes | no (the question stays in their logs)
    if forced:
        sys.stderr.write(f"{forced} (SEEKER_AI_CONFIRM)\n")
        return forced == "yes"
    try:
        with open("/dev/tty") as tty:
            return tty.readline().strip().lower() in ("y", "yes", "o", "oui")
    except OSError:
        return False


def needs_ok(name, args, conf):
    if name == "write_file" and target(args.get("path", ""), conf).exists():
        return True  # overwriting is irreversible: always ask
    if policy(conf, name, git_level(args, conf) if name == "git" else args.get("action")) == "auto":
        return False
    if name == "shell":
        cmd = args.get("command", "")
        return not (is_auto_cmd(cmd, conf["shell_auto_allow"]) and paths_ok(cmd, conf))
    if name == "system":
        return not is_auto_cmd(args.get("command", ""), conf["system_auto_allow"])
    return True


def call_tool(name, args, conf, tools):
    args = {k: v if isinstance(v, str) else json.dumps(v) for k, v in args.items()}  # models also send numbers and lists
    if name == "git" and git_level(args, conf) is None:
        return "error: git takes a subcommand first (" + ", ".join(GIT) + "), with no option before it"
    if name not in tools or policy(conf, name, git_level(args, conf) if name == "git" else args.get("action")) == "off":
        return f"error: {name} {args.get('action', '')} is not available".replace("  ", " ")
    # quotes and backslashes removed first: they cannot hide a package name. Applies even when you approve. Best effort:
    # a command that builds the name from variables or encoded text gets past it, and then only the approval prompt stops it.
    bare = re.sub(r"[\"'\\]", "", args.get("command", "") + args.get("code", ""))
    if name in ("system", "shell", "python") and PROTECTED.search(bare) and CHANGING.search(bare):
        return "refused: the agent may not change Seed Vault or Solana packages"
    # you approve what you see: the whole command, only a file's content is shortened (with a visible mark)
    shown = json.dumps({**args, **({"content": clip(args["content"], 600)} if "content" in args else {})}, ensure_ascii=False)
    if needs_ok(name, args, conf) and not confirm(f"\n[OPERATOR wants to run] {name} {plain(shown)}\nallow?"):
        return "denied by the user"
    try:
        return clip(str(tools[name][0](**args)), conf["max_tool_output"])
    except Exception as e:  # report to the model instead of crashing the chat
        return f"error: {type(e).__name__}: {e}"


# ---- models and llama-server ----
def models(conf):
    d = Path(conf["models_dir"]).expanduser()
    return sorted(p for p in d.glob("*.gguf") if not p.name.lower().startswith("mmproj")) if d.exists() else []


def find_model(conf, name):
    p = Path(name).expanduser()
    if p.is_file():
        return p.resolve()
    hits = [m for m in models(conf) if name.lower() in m.name.lower()]
    if len(hits) != 1:
        sys.exit(f"model '{name}': " + ("no match" if not hits else "ambiguous: " + ", ".join(h.name for h in hits))
                 + " (see seeker-ai --models)")
    return hits[0]


def get_json(url, timeout=2):
    try:
        with urllib.request.urlopen(url, timeout=timeout) as r:
            return json.loads(r.read() or b"{}")
    except (OSError, ValueError):
        return None


def server_up(url):
    return get_json(url + "/health") is not None


def is_llama_server(cmdline):
    """cmdline = bytes of /proc/PID/cmdline. Termux from Google Play starts every binary through /system/bin/linker64:
    the process is then NAMED linker64 (pgrep -x llama-server finds nothing) and the program is its first two words.
    Only those two are looked at: a script started with `--server .../llama-server` is not a server."""
    return any(os.path.basename(a) == b"llama-server" for a in cmdline.split(b"\0")[:2])


def server_pids():
    pids = []
    for p in Path("/proc").glob("[0-9]*"):
        try:
            if is_llama_server((p / "cmdline").read_bytes()):
                pids.append(int(p.name))
        except OSError:
            pass
    return pids


def stop_server():
    pids = server_pids()
    for sig in (signal.SIGTERM, signal.SIGKILL):
        for p in server_pids():
            try:
                os.kill(p, sig)
            except (ProcessLookupError, PermissionError):
                pass
        for _ in range(20):
            if not server_pids():
                return len(pids)
            time.sleep(0.5)
    return len(pids)


class Waiting:
    """`[label 12s]` on the terminal until stop(): a long wait (model loading, a 1200-token prompt) never looks like a hang."""
    def __init__(self, label):
        self.label, self.t0, self.done = label, time.time(), threading.Event()
        self.th = threading.Thread(target=self.tick, daemon=True) if sys.stderr.isatty() else None
        if self.th:
            self.th.start()

    def tick(self):
        while not self.done.wait(1):
            sys.stderr.write(f"\r\033[2m[{self.label} {time.time() - self.t0:.0f}s]\033[0m")
            sys.stderr.flush()

    def stop(self):
        if not self.done.is_set():
            self.done.set()
            if self.th:
                self.th.join()
                sys.stderr.write("\r\033[K")
                sys.stderr.flush()


def ensure_server(conf, model):
    """Returns True when it started llama-server (a cold one: nothing cached yet)."""
    url = conf["server"]
    if server_up(url):
        running = (get_json(url + "/props") or {}).get("model_path")
        if not running or Path(running).expanduser().resolve() == model.resolve():
            return False
        sys.stderr.write(f"switching model: {Path(running).name} -> {model.name}\n")
        stop_server()
    if not model.exists():
        sys.exit(f"model not found: {model} (see seeker-ai --models, install-model)")
    log = DATA / "server.log"
    log.parent.mkdir(parents=True, exist_ok=True)
    binary = str(Path(conf["llama_server"]).expanduser()) if "/" in conf["llama_server"] else conf["llama_server"]
    try:
        SLOTS.mkdir(parents=True, exist_ok=True)
        sleep = ["--sleep-idle-seconds", str(conf["sleep_idle_s"])] if conf["sleep_idle_s"] > 0 else []
        p = subprocess.Popen([binary, "-m", str(model), "-c", str(conf["ctx"]), "-t", str(conf["threads"]), "--jinja",
                              "--host", "127.0.0.1", "--port", url.rsplit(":", 1)[1], "--metrics", "--slot-save-path", str(SLOTS),
                              *sleep, *conf["server_args"]],
                             stdout=open(log, "a"), stderr=subprocess.STDOUT, start_new_session=True)
    except OSError as e:
        sys.exit(f"cannot start {binary}: {e} (key llama_server of {tilde(CONF_PATH)})")
    sys.stderr.write(f"starting llama-server with {model.name}\n")
    w = Waiting("loading the model")
    try:
        for _ in range(300):
            if server_up(url):
                return True
            if p.poll() is not None:  # an older llama.cpp (Termux's package) may not know --load-mode or --sleep-idle-seconds
                bad = re.findall(r"(?:invalid|unknown) argument[^\n]*", log.read_text(errors="replace")[-3000:])
                hint = (f": this llama-server is older than OPERATOR expects ({plain(bad[-1].strip())}). Update llama.cpp, or "
                        f'take that option out of {tilde(CONF_PATH)} ("server_args", or "sleep_idle_s": 0)') if bad else ""
                sys.exit(f"llama-server stopped at once (code {p.returncode}), see {tilde(log)}{hint}")
            time.sleep(1)
    finally:
        w.stop()
    sys.exit(f"llama-server did not start, see {log}")


def post_json(url, body, timeout=900):
    req = urllib.request.Request(url, json.dumps(body).encode(), {"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.loads(r.read() or b"{}")


PREFIX_MARK = "ZIONPREFIXMARK7Q"


def prefix_cache(conf, model, head, specs):
    """Have llama-server hold the fixed start of every request (instructions, tool schemas, memory notes): restored from
    disk in 0.2 s when a copy exists for exactly this model, settings and text, else computed once (43 s on the phone)
    and saved. The first answer then starts in about 1 s instead of 44 (tests/phone/probe-slots.json, 12/11).
    Any failure only costs that time: it is reported, never raised."""
    url = conf["server"]
    try:
        st = model.stat()
        key = hashlib.sha256(json.dumps([str(model), st.st_size, int(st.st_mtime), conf["ctx"], conf["server_args"],
                                         conf["thinking"], head, specs], sort_keys=True).encode()).hexdigest()[:16]
        name = f"prefix-{key}.bin"
        if (SLOTS / name).exists():
            try:
                if post_json(f"{url}/slots/0?action=restore", {"filename": name}).get("n_restored"):
                    return "restored"
            except (OSError, ValueError, http.client.HTTPException):
                pass
            (SLOTS / name).unlink(missing_ok=True)  # made by another build or settings: computed again below
        body = {"messages": head + [{"role": "user", "content": PREFIX_MARK}], "chat_template_kwargs": {"enable_thinking": conf["thinking"]}}
        prompt = post_json(f"{url}/apply-template", {**body, **({"tools": specs} if specs else {})})["prompt"]
        post_json(f"{url}/completion", {"prompt": prompt[:prompt.index(PREFIX_MARK)], "n_predict": 0, "cache_prompt": True})
        post_json(f"{url}/slots/0?action=save", {"filename": name})
        for old in sorted(SLOTS.glob("prefix-*.bin"), key=lambda f: f.stat().st_mtime)[:-3]:
            old.unlink()  # the 3 most recent are kept, about 200 MB each
        return "saved"
    except (OSError, ValueError, KeyError, http.client.HTTPException) as e:
        return f"not cached: {e}"


def wake_with_prefix(conf):
    """The server unloaded the model after sleep_idle_s: reload it now with the prefix restored, not recomputed."""
    if conf.get("_prefix") and (get_json(conf["server"] + "/props") or {}).get("is_sleeping"):
        w = Waiting("waking the model")
        try:
            prefix_cache(conf, *conf["_prefix"])
        finally:
            w.stop()


def complete(conf, messages, tools):
    body = {"messages": messages, "stream": True, "chat_template_kwargs": {"enable_thinking": conf["thinking"]}, **conf["sampling"]}
    if conf.get("_remote_model"):
        body["model"] = conf["_remote_model"]
    if tools:
        body["tools"] = tools
    req = urllib.request.Request(conf["server"] + "/v1/chat/completions", json.dumps(body).encode(),
                                 {"Content-Type": "application/json"})
    text, calls, timings, t0, ttft = "", {}, None, time.time(), None
    wait = Waiting("thinking")
    try:
        with urllib.request.urlopen(req, timeout=900) as r:
            for raw in r:
                line = raw.decode().strip()
                if not line.startswith("data: ") or line == "data: [DONE]":
                    continue
                chunk = json.loads(line[6:])
                if chunk.get("error"):
                    raise ServerError(json.dumps(chunk["error"], ensure_ascii=False)[:400])
                timings = chunk.get("timings") or timings
                delta = (chunk.get("choices") or [{}])[0].get("delta") or {}
                if ttft is None and (delta.get("content") or delta.get("reasoning_content") or delta.get("tool_calls")):
                    ttft = time.time() - t0
                    wait.stop()
                if delta.get("reasoning_content"):
                    sys.stdout.write(f"\033[2m{plain(delta['reasoning_content'])}\033[0m")
                if delta.get("content"):
                    text += delta["content"]
                    sys.stdout.write(plain(delta["content"]))
                for tc in delta.get("tool_calls") or []:
                    c = calls.setdefault(tc.get("index", 0), {"id": "", "name": "", "args": ""})
                    f = tc.get("function") or {}
                    c["id"] = tc.get("id") or c["id"]
                    c["name"] += f.get("name") or ""
                    c["args"] += f.get("arguments") or ""
                sys.stdout.flush()
    except urllib.error.HTTPError as e:  # e.g. 400 exceed_context_size_error
        raise ServerError(f"{e.code} {e.read().decode(errors='replace')[:400]}") from None
    except (OSError, http.client.HTTPException) as e:
        raise ServerError(f"llama-server unreachable or connection lost: {e}") from None
    finally:
        wait.stop()
    if timings:
        conf["_used"] = sum(timings.get(k) or 0 for k in ("cache_n", "prompt_n", "predicted_n"))  # tokens now in the context
        DATA.mkdir(parents=True, exist_ok=True)
        with open(DATA / "perf.jsonl", "a") as f:
            f.write(json.dumps({"t": time.time(), "model": Path(conf.get("_model", "")).name, "ctx": conf["ctx"],
                                "ttft_s": round(ttft, 2) if ttft else None, **{k: timings.get(k) for k in
                    ("prompt_n", "prompt_ms", "prompt_per_second", "predicted_n", "predicted_ms", "predicted_per_second")}}) + "\n")
        if conf["show_speed"]:
            sys.stderr.write(f"\n\033[2m[{timings.get('predicted_per_second', 0):.1f} tok/s, {timings.get('predicted_n')} tokens; "
                             f"prompt {timings.get('prompt_n')} tok at {timings.get('prompt_per_second', 0):.1f} tok/s; "
                             f"first token {ttft or 0:.1f}s]\033[0m")
    return text, [calls[i] for i in sorted(calls)]


def forget_oldest(conf, messages):
    """Context nearly full: drop the older half of the exchanges, never the system prompt, the memory notes nor the
    current request. One big cut, not one per turn: everything after it is processed again (about a minute here)."""
    start = 3 if messages[1:3] and messages[1]["content"].startswith(NOTES) else 1  # the notes pair stays
    users = [i for i in range(start + 1, len(messages)) if messages[i]["role"] == "user"]
    if not users:
        return False
    del messages[start:users[(len(users) - 1) // 2]]
    sys.stderr.write("\033[2m[context nearly full: the oldest exchanges are forgotten]\033[0m\n")
    return True


def turn(conf, messages, tool_specs_, tools, save=None):
    """One request: model answers, tools run, until a plain answer. save() runs after every tool round, so a task
    interrupted by Android (Termux killed for memory) keeps its progress in the session file."""
    used = []
    warm = conf.pop("_warm", None)
    if warm and warm.is_alive():  # the prefix is still being prepared: wait (the request would wait in the server anyway)
        w = Waiting("preparing OPERATOR, first time only")
        warm.join()
        w.stop()
    wake_with_prefix(conf)
    for _ in range(MAX_ROUNDS):
        if conf.get("_used", 0) > 0.75 * conf["ctx"] and forget_oldest(conf, messages):
            conf["_used"] = 0
        while True:
            try:
                text, calls = complete(conf, messages, tool_specs_)
                break
            except ServerError as e:  # the request itself is larger than the context: forget more, or give up
                if "context" not in str(e) or not forget_oldest(conf, messages):
                    raise
        msg = {"role": "assistant", "content": text}
        if calls:
            msg["tool_calls"] = [{"id": c["id"] or f"call{i}", "type": "function",
                                  "function": {"name": c["name"], "arguments": c["args"] or "{}"}} for i, c in enumerate(calls)]
        messages.append(msg)
        if not calls:
            print()
            return used
        denied = False
        for tc in msg["tool_calls"]:
            try:
                args = json.loads(tc["function"]["arguments"])
            except json.JSONDecodeError:
                args = None
            name = tc["function"]["name"]
            if denied:  # the user refused an earlier call of this answer: the calls after it do not run either
                out = "not run: the user refused an earlier action of this request"
            else:
                out = call_tool(name, args, conf, tools) if isinstance(args, dict) else "error: arguments are not valid JSON"
            # the model chose the name and the action: plain() before the terminal and the history see them
            label = plain(str(name))[:60] + (f":{plain(str(args['action']))[:40]}" if isinstance(args, dict) and args.get("action") else "")
            used.append(label)
            sys.stderr.write(f"\033[2m[step {len(used)} {label}] {plain(out[:200])}\033[0m\n")
            if out == "denied by the user":
                denied = True
                out += ": NOT done. Do not try again, nor another way; tell the user it was not done."
            messages.append({"role": "tool", "tool_call_id": tc["id"], "content": out})
        if save:
            save()
        if denied:  # the user said no: one last answer without tools, so the model cannot ask again (it did, 12 times)
            text, _ = complete(conf, messages, [])
            messages.append({"role": "assistant", "content": text})
            print()
            return used
    print(f"\n[stopped after {MAX_ROUNDS} tool rounds]")
    return used


def system_text(conf, agent):
    f = CONF_PATH.parent / "system.md"
    if f.exists():
        return f.read_text()
    return conf["system_prompt"] or (SYSTEM_AGENT.format(workdir=tilde(Path(conf["workdir"]).expanduser())) if agent else SYSTEM_CHAT)


NOTES = "Notes kept (local memory):"
NOTES_ACK = "Noted. I answer each request in its own language, whatever the language of these notes."  # an English question got a French answer after French notes, in chat mode (12/11)


def notes_pair(conf):
    """The memory notes as an exchange of their own, before the conversation: inside the request they set its language
    (French notes made the model answer an English question in French, on the phone, 12/11)."""
    text = memory_notes(conf)
    return [{"role": "user", "content": text.strip()}, {"role": "assistant", "content": NOTES_ACK}] if text else []


def memory_notes(conf):
    # Goes in the first user message, not the system prompt: the system prompt + tools prefix (~1200 tokens, minutes
    # of prompt processing on this phone) then stays identical between calls and llama-server reuses its cache.
    mem = DATA / "memory.md"
    notes = mem.read_text()[-conf["memory_chars"]:] if mem.exists() else ""
    return f"{NOTES}\n{notes}\n\n" if notes else ""


def attach(paths, conf):
    return "\n".join(f'<file path="{p}">\n{allowed(p, conf).read_text(errors="replace")}\n</file>' for p in paths)


def log_task(mode, prompt, used, error=None):
    DATA.mkdir(parents=True, exist_ok=True)
    with open(DATA / "history.jsonl", "a") as f:
        f.write(json.dumps({"t": time.strftime("%Y-%m-%d %H:%M:%S"), "mode": mode, "prompt": prompt[:200],
                            "tools": used, "error": error}, ensure_ascii=False) + "\n")


def save_session(path, messages):
    if not any(m.get("role") == "user" and not str(m.get("content") or "").startswith(NOTES) for m in messages[1:]):
        return  # nothing asked yet (Ctrl+C on the first request): --resume must not pick an empty chat
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(json.dumps(messages[1:], ensure_ascii=False))
    os.replace(tmp, path)  # never half a file, even if Android kills Termux while it writes


def load_session(path):
    """The saved messages, or None if the file is unreadable or not a chat."""
    try:
        msgs = json.loads(path.read_text())
    except (OSError, ValueError):
        return None
    ok = isinstance(msgs, list) and all(isinstance(m, dict) and isinstance(m.get("role"), str) for m in msgs)
    return msgs if ok else None


def status(conf):
    url = conf["server"]
    props = get_json(url + "/props") if server_up(url) else None
    print(f"server       {'stopped' if props is None else 'sleeping (model unloaded, reloads on use)' if props.get('is_sleeping') else 'online'} ({url})")
    running = (props or {}).get("model_path")
    print(f"model        default {Path(conf['model']).name}" + (f", running {Path(running).name}" if running else ""))
    if props:
        print(f"context      {(props.get('default_generation_settings') or {}).get('n_ctx', '?')} tokens")
    for pid in server_pids():
        st = Path(f"/proc/{pid}/status").read_text() if Path(f"/proc/{pid}/status").exists() else ""
        mem = {k: int(v) // 1024 for k, v in re.findall(r"(VmRSS|VmHWM):\s+(\d+)", st)}
        print(f"memory       llama-server pid {pid}: {mem.get('VmRSS', '?')} MB now, {mem.get('VmHWM', '?')} MB peak")
    perf = DATA / "perf.jsonl"
    rows = [json.loads(l) for l in perf.read_text().splitlines()[-20:]] if perf.exists() else []
    avg = lambda k: sum(r[k] for r in rows if r.get(k)) / max(1, len([r for r in rows if r.get(k)]))
    if rows:
        print(f"speed        last {len(rows)} answers: generation {avg('predicted_per_second'):.1f} tok/s, "
              f"prompt {avg('prompt_per_second'):.1f} tok/s, first token {avg('ttft_s'):.1f} s")
    print("permissions  " + ", ".join(f"{k}={v}" for k, v in conf["levels"].items()))
    print("tools        " + ", ".join(f"{n}={policy(conf, n)}" for n in TOOL_LEVEL))
    print("android      " + ", ".join(f"{k}={policy(conf, 'android', k)}" for k in conf["android_actions"]))
    print(f"shizuku      {'ready (rish)' if rish_path() else 'not set up'}")
    cached = sorted(SLOTS.glob("prefix-*.bin")) if SLOTS.exists() else []
    print(f"prefix cache {len(cached)} file(s), {sum(f.stat().st_size for f in cached) / 1e6:.0f} MB in {tilde(SLOTS)}"
          f"{'' if conf['prefix_cache'] else ' (off)'}; sleep after {conf['sleep_idle_s']} s idle")
    changes = DATA / "changes.tsv"
    for l in (changes.read_text().splitlines()[-5:] if changes.exists() else []):
        print(f"change       {l}")
    hist = DATA / "history.jsonl"
    for l in (hist.read_text().splitlines()[-5:] if hist.exists() else []):
        h = json.loads(l)
        print(f"task         {h['t']} {h['mode']}: {h['prompt'][:60]}" + (f" [{', '.join(h['tools'])}]" if h["tools"] else ""))


def saved_sessions():
    d = DATA / "sessions"
    return sorted(d.glob("*.json")) if d.exists() else []


def session_line(i, path):
    msgs = load_session(path)
    if msgs is None:
        return f"{i:3}  {path.stem}  (unreadable)"
    first = next((m["content"] for m in msgs if m["role"] == "user" and not m["content"].startswith(NOTES)), "")
    return f"{i:3}  {path.stem}  {len(msgs):3} messages  {plain(first)[:60]!r}" + ("  [interrupted]" if interrupted(msgs) else "")


def interrupted(msgs):
    """The saved chat ends in the middle of a task (tool calls without a final answer): Termux killed, phone restarted."""
    return bool(msgs) and (msgs[-1]["role"] == "tool" or bool(msgs[-1].get("tool_calls")))


def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("prompt", nargs="*")
    ap.add_argument("-f", "--file", action="append", default=[])
    ap.add_argument("--resume", action="store_true", help="continue the last saved chat")
    ap.add_argument("--chat", action="store_true", help="conversation only, no tools")
    ap.add_argument("--models", action="store_true", help="list the models")
    ap.add_argument("--use", metavar="NAME", help="make a model the default")
    ap.add_argument("--model", metavar="NAME", help="use a model for this run only")
    ap.add_argument("--start", action="store_true", help="start llama-server and exit")
    ap.add_argument("--stop", action="store_true", help="stop llama-server (frees its memory)")
    ap.add_argument("--status", action="store_true", help="server, model, memory, speed, permissions, last tasks")
    ap.add_argument("--remote", action="store_true", help='use the server of config key "remote" (e.g. the Mac), not the phone\'s')
    a = ap.parse_args()
    conf = load_conf()
    if a.remote:
        conf["server"], conf["_remote_model"] = conf["remote"]["server"].rstrip("/"), conf["remote"]["model"]
        host = urllib.parse.urlsplit(conf["server"]).hostname or ""
        if host not in ("127.0.0.1", "localhost", "::1") and not conf["remote"].get("allow_lan"):
            sys.exit(f"remote server {plain(host)} refused: over plain HTTP any device on the network could read the chat and "
                     f'answer in OPERATOR\'s place. Use the adb reverse link (comment above "remote" in seeker-ai), or add '
                     f'"allow_lan": true to "remote" in {tilde(CONF_PATH)} if you accept that.')
        if not conf["_remote_model"]:
            sys.exit(f'set "remote": {{"server": ..., "model": ...}} in {tilde(CONF_PATH)} (see the comment in seeker-ai)')
    if a.models:
        default = Path(conf["model"]).expanduser().resolve()
        for m in models(conf):
            print(f"{'*' if m.resolve() == default else ' '} {m.name:55} {m.stat().st_size / 1e9:5.2f} GB")
        return
    if a.use:
        m = find_model(conf, a.use)
        save_conf(model=tilde(m))
        print(f"default model: {m.name} (previous config backed up next to {tilde(CONF_PATH)})")
        if server_up(conf["server"]) and stop_server():
            print("llama-server stopped: it restarts with this model on next use")
        return
    if a.stop:
        print(f"stopped {stop_server()} llama-server process(es)")
        return
    if a.status:
        status(conf)
        return
    model = Path(conf["_remote_model"]) if a.remote else find_model(conf, a.model) if a.model else Path(conf["model"]).expanduser()
    conf["_model"] = str(model)
    try:  # -f paths start where you are, not in the agent's work folder, and are read before the model loads
        files = attach([str(Path(f).expanduser().resolve()) for f in a.file], conf)
    except OSError as e:
        sys.exit(f"cannot read: {e}")
    if a.remote:
        if get_json(conf["server"] + "/v1/models", timeout=5) is None:
            sys.exit(f"remote server not reachable at {conf['server']} (on the Mac: adb reverse tcp:8081 tcp:11434, Ollama running)")
        started = False
    else:
        try:
            started = ensure_server(conf, model)
        except KeyboardInterrupt:
            sys.exit("\n(stopped; llama-server may still be loading in the background: seeker-ai --stop frees it)")
    if a.start:
        print(f"online: {model.name} on {conf['server']}")
        return
    agent = not a.chat
    tools = make_tools(conf)
    specs = tool_specs(conf, tools) if agent else []
    messages = [{"role": "system", "content": system_text(conf, agent)}]
    mode = "agent" if agent else "chat"
    if not a.remote and conf["prefix_cache"]:
        conf["_prefix"] = (model, messages[:1] + notes_pair(conf), specs)
    stdin_text = None if sys.stdin.isatty() else sys.stdin.read()
    if started and conf.get("_prefix"):  # a cold server: restore the prefix from disk, or compute and save it
        if a.prompt or stdin_text:
            w = Waiting("preparing")
            prefix_cache(conf, *conf["_prefix"])
            w.stop()
        else:  # while you type your first message
            conf["_warm"] = threading.Thread(target=prefix_cache, args=(conf, *conf["_prefix"]), daemon=True)
            conf["_warm"].start()
    if a.prompt or stdin_text:
        prompt = " ".join(a.prompt)
        piped = f"<stdin>\n{stdin_text}\n</stdin>" if stdin_text else ""
        messages += notes_pair(conf)
        messages.append({"role": "user", "content": "\n".join(filter(None, [files, piped, prompt]))})
        try:
            log_task(mode, prompt, turn(conf, messages, specs, tools))
        except KeyboardInterrupt:
            log_task(mode, prompt, [], "stopped by the user")
            sys.exit("\n(stopped)")
        except ServerError as e:
            log_task(mode, prompt, [], f"server error {str(e)[:80]}")
            sys.exit(f"\n[server error] {plain(str(e))}")
        return
    sessions = DATA / "sessions"
    session = sessions / time.strftime("%Y%m%d-%H%M%S.json")

    def resume(path):
        nonlocal session
        loaded = load_session(path)
        if loaded is None:
            print(f"(cannot read {path.name}: not resumed)")
            return False
        session = path
        del messages[1:]
        messages.extend(loaded)
        print(f"(resumed {path.name}, {len(messages) - 1} messages)"
              + ("\n(this task was interrupted before its end: say \"continue\" and OPERATOR goes on)" if interrupted(messages) else ""))
        return True
    if a.resume:
        for path in reversed(saved_sessions()):  # the newest one that can be read
            if resume(path):
                break
    pending = files
    where = f"remote {conf['server']}" if a.remote else "offline"
    print(f"OPERATOR {mode}, {model.name}, {where}. /file PATH  /tools  /memory  /history  /resume [N]  /reset  /exit")
    while True:
        try:
            line = input("> ").strip()
        except (EOFError, KeyboardInterrupt):
            print()
            return
        if not line:
            continue
        if line in ("/exit", "/quit"):
            return
        if line == "/reset":
            del messages[1:]
            session = sessions / time.strftime("%Y%m%d-%H%M%S.json")
            print("(new conversation)")
            continue
        if line == "/tools":
            status(conf)
            continue
        if line == "/history":
            for i, path in enumerate(reversed(saved_sessions()[-10:]), 1):
                print(session_line(i, path))
            continue
        if line == "/resume" or line.startswith("/resume "):
            arg, saved = line[8:].strip() or "1", saved_sessions()
            if not arg.isdigit() or not 1 <= int(arg) <= len(saved):
                print(f"(/resume N, with N from /history: 1 = the most recent of {len(saved)})")
                continue
            resume(saved[-int(arg)])
            continue
        if line == "/system":
            print(plain(messages[0]["content"]))
            continue
        if line == "/memory":
            mem = DATA / "memory.md"
            print(plain(mem.read_text()) if mem.exists() else "(empty)")
            continue
        if line == "/forget":
            if confirm("erase all long-term memory?"):
                (DATA / "memory.md").unlink(missing_ok=True)
                print("(memory erased)")
            continue
        if line.startswith("/file "):
            try:
                pending += "\n" + attach([line[6:].strip()], conf)
                print("(attached)")
            except (OSError, PermissionError) as e:
                print(f"(cannot read: {e})")
            continue
        if len(messages) == 1:
            messages += notes_pair(conf)
        request = {"role": "user", "content": (pending + "\n" + line).strip()}
        before = [dict(m) for m in messages]  # forget_oldest cuts and rewrites messages while the turn retries
        messages.append(request)
        pending = ""
        try:
            log_task(mode, line, turn(conf, messages, specs, tools, lambda: save_session(session, messages)))
        except (KeyboardInterrupt, ServerError) as e:  # keep the chat alive, without the unfinished request
            messages[:] = before
            error = "stopped by the user" if isinstance(e, KeyboardInterrupt) else f"server error {str(e)[:80]}"
            log_task(mode, line, [], error)
            print(f"\n({error}; this request is forgotten)" + ("" if isinstance(e, KeyboardInterrupt) else f"\n{e}"))
        save_session(session, messages)


if __name__ == "__main__":
    main()
