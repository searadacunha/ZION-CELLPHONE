def ui_parse(out):
    """What UI_LOOK printed: the focused window, the package of the tree, secure flag, lock, and the tree (None when
    Android gave none, as in the middle of a transition)."""
    head, _, xml = out.partition("ZIONUI")
    focus = re.search(r"mCurrentFocus=Window\{\S+ \S+ ([^}]+)\}", head)
    win = re.search(r" package=(\S+)", head)
    flags = re.search(r" fl=(.*)", head)
    a, b, root = xml.find("<hierarchy"), xml.rfind("</hierarchy>"), None
    if 0 <= a < b:
        try:
            root = ET.fromstring(xml[a:b + 12])
        except ET.ParseError:
            pass
    top = root.find("node") if root is not None else None
    name = focus.group(1) if focus else ""
    if "/" in name:  # com.android.settings/com.android.settings.Settings -> com.android.settings/.Settings
        pkg, _, cls = name.partition("/")
        name = pkg + "/" + (cls[len(pkg):] if cls.startswith(pkg + ".") else cls)
    return {"focus": name, "win": win.group(1) if win else "", "pkg": top.get("package", "") if top is not None else "",
            "secure": bool(flags and re.search(r"\bSECURE\b", flags.group(1))),
            "locked": "isKeyguardShowing=true" in head, "root": root}


def ui_box(n):
    m = re.fullmatch(r"\[(-?\d+),(-?\d+)\]\[(-?\d+),(-?\d+)\]", n.get("bounds", ""))
    return tuple(map(int, m.groups())) if m else (0, 0, 0, 0)


def ui_elements(root):
    """(elements, texts, scroll box, scrolls): an element is what can be tapped or typed in, in reading order; texts are
    the labels nobody can tap; the scroll box is the largest scrollable area (the whole screen without one); scrolls
    says whether there is one."""
    top = root.find("node")
    screen = ui_box(top) if top is not None else (0, 0, 0, 0)
    els, texts, scroll = [], [], [screen]
    # a text field: UiShell says so; uiautomator's dump does not, there the class name tells (a search box is an
    # AutoCompleteTextView)
    field = lambda a: a.get("editable") == "true" or a.get("class", "").endswith(("EditText", "AutoCompleteTextView"))
    acts = lambda a: a.get("clickable") == "true" or a.get("long-clickable") == "true" or field(a)

    def below(n, got):  # the texts under an element that no element of their own holds, and a switch's position
        for c in n:
            a = c.attrib
            if acts(a):
                continue
            if a.get("text") or a.get("content-desc"):
                got["t"].append(a.get("text") or a.get("content-desc"))
            if a.get("checkable") == "true":
                got["on"] = a.get("checked") == "true"
            below(c, got)

    def walk(n, held):
        a = n.attrib
        x1, y1, x2, y2 = box = ui_box(n)
        if x2 <= x1 or y2 <= y1 or x2 <= screen[0] or y2 <= screen[1] or x1 >= screen[2] or y1 >= screen[3]:
            return  # nothing of it is on the screen
        if a.get("scrollable") == "true" and (x2 - x1) * (y2 - y1) > 0:
            scroll.append(box)
        mine = acts(a) and a.get("enabled") != "false"
        if mine:
            got = {"t": [], "on": (a.get("checked") == "true") if a.get("checkable") == "true" else None}
            below(n, got)
            edit, secret = field(a), a.get("password") == "true"
            rid = a.get("resource-id", "").rsplit("/", 1)[-1]
            label = " | ".join(dict.fromkeys(t for t in [a.get("text") or a.get("content-desc") or a.get("hint"), *got["t"]] if t))
            if label or edit or rid:  # an icon with no text, no description and no id tells the model nothing
                els.append({"kind": "input" if edit else "switch" if got["on"] is not None else "button", "on": got["on"],
                            "label": "" if secret else label or f"id:{rid}", "secret": secret, "sel": a.get("selected") == "true",
                            "focused": a.get("focused") == "true", "xy": ((x1 + x2) // 2, (y1 + y2) // 2)})
        elif not held and (a.get("text") or a.get("content-desc")):
            texts.append((a.get("text") or a.get("content-desc")) + (" (disabled)" if acts(a) else ""))
        for c in n:
            walk(c, held or mine)

    if top is not None:
        walk(top, False)
    return els, texts, max(scroll[1:] or scroll, key=lambda b: (b[2] - b[0]) * (b[3] - b[1])), len(scroll) > 1


def ui_describe(st, els, texts, scrolls=False):
    """The screen for the model: `N kind [state] "label"` per element, then the plain texts."""
    lines = [f"screen: {st['focus'] or st['pkg'] or '?'}"]
    for i, e in enumerate(els[:UI_MAX], 1):
        state = ("" if e["on"] is None else " [on]" if e["on"] else " [off]") + (" [selected]" if e["sel"] else "")
        lines.append(f"{i} {e['kind']}{state} " + ("(password field)" if e["secret"] else json.dumps(e["label"][:80], ensure_ascii=False)))
    if len(els) > UI_MAX:
        lines.append(f"(+{len(els) - UI_MAX} more elements: scroll)")
    lines += [f"- {json.dumps(t[:100], ensure_ascii=False)}" for t in list(dict.fromkeys(texts))[:12]]
    if any(e["label"].isdigit() for e in els[:UI_MAX]):  # a keypad: "3" is a key's name and an element's number (the
        # calculator, 13/11: 12 + 30 became 123+0). The name wins, the number takes a #, and keys go several at once
        lines.append('(keys named by digits here: target "7" presses the key 7, "#7" is element 7; several keys in one tap: "1 2 + 3 =")')
    if scrolls:  # without it the model takes what it sees for the whole page (About phone is 4 screens down in Settings)
        lines.append("(this screen scrolls: ui scroll down shows what is below)")
    return "\n".join(lines) if els or texts else lines[0] + "\n(nothing readable on this screen)"


# a password given in a request ("connecte-toi, mdp: ...", seen in the history on 13/11) is needed for that request only:
# the history, the status lines and the task reports keep the word before it, not the password
SECRET = re.compile(r"(?i)\b(mdp|mot de passe|password|passwd|passphrase|pwd)\b(\s*(?:est|is)?\s*[:=]?\s*)(\S+)")


def secretless(text):
    return SECRET.sub(lambda m: m.group(1) + m.group(2) + "***", text)


TYPED = set()  # passwords typed in this run on the owner's dictation: never written to a trace, a step or a report


def untyped(x):
    """x (text, list or dict) without the passwords typed in this run."""
    if isinstance(x, str):
        for word in TYPED:
            x = x.replace(word, "***")
        return x
    if isinstance(x, list):
        return [untyped(v) for v in x]
    return {k: untyped(v) for k, v in x.items()} if isinstance(x, dict) else x


def load_conf():
    c = json.loads(json.dumps(DEFAULT))
    if CONF_PATH.exists():
        user = json.loads(CONF_PATH.read_text())
        for k, v in user.items():
            c[k] = {**c[k], **v} if isinstance(c.get(k), dict) else v
    c["zion"] = load_policy()
    return c


def load_policy():
    """The owner's policy over the defaults. Anything unreadable or misspelt falls back to the safe side: an app that
    is not a package name is not allowed, a class value other than auto|approve|deny means approve."""
    p = json.loads(json.dumps(ZION_POLICY))
    try:
        user = json.loads(POLICY_PATH.read_text()) if POLICY_PATH.exists() else {}
    except (OSError, ValueError) as e:
        sys.stderr.write(f"policy {tilde(POLICY_PATH)} unreadable ({e}): defaults used\n")
        user = {}
    for k, v in (user.items() if isinstance(user, dict) else []):
        if k in p:
            p[k] = {**p[k], **v} if isinstance(p[k], dict) and isinstance(v, dict) else v
    p["apps"] = sorted({a for a in p["apps"] if isinstance(a, str) and PKG.fullmatch(a)}) if isinstance(p["apps"], list) else []
    p["classes"] = {k: v if v in ("auto", "approve", "deny") else "approve" for k, v in p["classes"].items()}
    p["limits"] = {k: v if isinstance(v, (int, float)) else ZION_POLICY["limits"].get(k) for k, v in p["limits"].items()}
    return p


def save_conf(**kv):
    """Change keys of the user's config file, after a dated backup of it."""
    raw = json.loads(CONF_PATH.read_text()) if CONF_PATH.exists() else {}
    if CONF_PATH.exists():
        shutil.copy2(CONF_PATH, CONF_PATH.with_name(f"config.json.bak-{time.strftime('%Y%m%d-%H%M%S')}"))
    raw.update(kv)
    CONF_PATH.parent.mkdir(parents=True, exist_ok=True)
    CONF_PATH.write_text(json.dumps(raw, indent=2, ensure_ascii=False))


def tilde(p):
    p, h = str(p), str(HOME)
    return "~" + p[len(h):] if p.startswith(h + "/") else p


def is_auto_cmd(cmd, allow):
    try:
        words = shlex.split(cmd)
    except ValueError:
        return False
    return bool(words) and words[0] in allow and not (set(cmd) & (META | GLOB))


class ServerError(Exception):
    """llama-server refused the request (HTTP error, error event) or the connection was lost."""


class Stopped(Exception):
    """The owner's emergency stop: nothing more runs until he resumes (zion-stop --resume, or the launcher)."""


class NeedsApproval(Exception):
    """An unattended call that the owner must approve himself: zion parks the task and asks him."""


def stop_check():
    if STOP.exists():
        raise Stopped(STOP.read_text(errors="replace").strip()[:120] or "emergency stop")


def guard(name, out, conf):
    """A tool's answer that gives an AI orders: told to the model, and what runs on its own narrows (permit)."""
    if hit := INJECT.search(INVISIBLE.sub("", out)):
        conf["_tainted"] = f"{name}: {plain(hit.group(0))[:80]}"
        return GUARD_NOTE + out
    return out


def call_digest(name, args):
    return hashlib.sha256(json.dumps([name, args], sort_keys=True, ensure_ascii=False).encode()).hexdigest()


def action_class(name, args, conf):
    """What a call does, for the owner's policy (ui decides per screen, in t_ui)."""
    if name in ("shell", "system"):
        cmd = args.get("command", "")
        auto = is_auto_cmd(cmd, conf["shell_auto_allow" if name == "shell" else "system_auto_allow"])
        return "ordinary" if auto and (name == "system" or paths_ok(cmd, conf)) else "exec"
    if name == "python":
        return "exec"
    if name == "fetch_url":
        return "network"
    if name == "git":
        return {"read": "ordinary", "sensitive": "network"}.get(git_level(args, conf), "exec")
    if name == "write_file" and target(args.get("path", ""), conf).resolve().exists():
        return "system"  # overwriting cannot be undone
    if name == "android":  # net_status "reapply" blocks again what the journal says: a network change
        return "system" if args.get("action") == "net_status" and args.get("value") == "reapply" else \
            ANDROID_CLASS.get(args.get("action"), "ordinary")
    if name == "remember":  # a note goes into every later chat: in zion's queued tasks, where no one is in the loop at
        return "system" if conf.get("_can_park") else "ordinary"  # all, the owner approves it; asked on the ai screen, not
    return "ordinary"


def permit(conf, cls, name, args, what, replay=None):
    """When nobody is at the terminal: None if this call may run now, else why not; or NeedsApproval in zion's tasks,
    where the owner approves the exact call (its digest), later, himself. args = what the approval covers; replay =
    the arguments that run it again once approved, when they differ (a screen element by its label, not its number)."""
    verdict = conf["zion"]["classes"].get(cls, "approve")
    if conf.get("_tainted") and cls != "ordinary" and verdict == "auto":
        verdict = "approve"  # after a text that tried to steer the AI, nothing beyond ordinary runs on its own
    digest = call_digest(name, args)
    if digest in conf.get("_denied", ()):
        return "refused: the owner refused this action. Do not try it again, nor another way: say it was not done."
    if digest in conf.get("_done", {}):  # run once with his approval when the task went on: never twice on one approval
        return f"done already, with the owner's approval: {conf['_done'][digest][:300]}"
    if verdict == "deny":  # absolute: no approval, even one passed in, reopens it
        return f"refused: the owner's policy forbids this ({cls}: {what}). Say it was not done."
    if verdict == "auto" or digest in conf.get("_approved", ()):
        conf.get("_approved", set()).discard(digest)  # an approval covers one run
        return None
    if conf.get("_can_park"):
        raise NeedsApproval({"class": cls, "what": what[:4000], "digest": digest, "call": {"name": name, "args": replay or args}})
    return f"refused: {what} needs the owner's own approval ({cls}), which this screen cannot ask. Tell the user."


class SafeRedirect(urllib.request.HTTPRedirectHandler):
    """You approved one URL: a redirect may not switch to another scheme or to this phone or the local network."""
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        u = urllib.parse.urlsplit(newurl)
        try:
            local = u.hostname in (None, "localhost") or not ipaddress.ip_address(u.hostname).is_global
        except ValueError:
            local = False  # a name: resolved by the system, as for the approved URL
        if u.scheme not in ("http", "https") or local:
            raise urllib.error.URLError(f"redirect to {newurl} refused")
        return super().redirect_request(req, fp, code, msg, headers, newurl)


def plain(s):
    return CTRL.sub(lambda m: f"\\u{ord(m.group()):04x}", s)


def paths_ok(cmd, conf):
    """The arguments of an auto-allowed shell command stay where the file tools may look: `ls ~/.ssh` asks first."""
    for w in shlex.split(cmd)[1:]:
        if not w.startswith("-"):
            try:
                allowed(w, conf)
            except PermissionError:
                return False
    return True


def clip(s, n):
    return s if len(s) <= n else s[:n] + f"\n[... {len(s) - n} more characters cut]"


def workdir(conf):
    w = Path(conf["workdir"]).expanduser()
    w.mkdir(parents=True, exist_ok=True)
    return w


def target(path, conf):
    p = Path(path).expanduser()
    return p if p.is_absolute() else Path(conf["workdir"]).expanduser() / p


def allowed(path, conf):
    p = target(path, conf).resolve()
    inside = lambda r: p == r or r in p.parents
    for d in conf["denied_paths"]:
        if inside(Path(d).expanduser().resolve()):
            raise PermissionError(f"{p} is in a protected folder ({d})")
    hidden = False
    for root in conf["allowed_paths"]:
        r = Path(root).expanduser().resolve()
        if inside(r):
            # dotfiles hold credentials (.ssh, .netrc, .env) and code that runs by itself (.bashrc, .git/hooks):
            # reachable only below a root that names the hidden folder itself
            if not any(part.startswith(".") for part in p.relative_to(r).parts):
                return p
            hidden = True
    raise PermissionError(f"{p} is a hidden file or folder (protected)" if hidden
                          else f"{p} is outside the allowed folders {conf['allowed_paths']}")


def run(argv, timeout=300, cwd=None):
    # one stream, in the order printed (rish, Shizuku's shell, spreads its output between stdout and stderr at random)
    r = subprocess.run(argv, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, timeout=timeout, cwd=cwd,
                       stdin=subprocess.DEVNULL)
    return f"exit {r.returncode}\n{r.stdout}"


