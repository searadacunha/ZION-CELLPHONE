def session_line(i, path):
    msgs = load_session(path)
    if msgs is None:
        return f"{i:3}  {path.stem}  (unreadable)"
    first = next((m["content"] for m in msgs if m["role"] == "user" and not m["content"].startswith(NOTES)), "")
    return f"{i:3}  {path.stem}  {len(msgs):3} messages  {plain(secretless(first))[:60]!r}" + ("  [interrupted]" if interrupted(msgs) else "")


def interrupted(msgs):
    """The saved chat ends in the middle of a task (tool calls without a final answer): Termux killed, phone restarted."""
    return bool(msgs) and (msgs[-1]["role"] == "tool" or bool(msgs[-1].get("tool_calls")))


# ---- tasks (seeker-ai --task): plan, run step by step, keep the progress on disk, resume, report what the tools showed ----
# Each step is a short conversation of its own: a 4096-token context holds one step, not a whole task, and what is on
# disk survives Android closing Termux. The plan comes through a tool call, the model's surest structured output
# (30 right calls out of 30 on the phone, tests/phone/bench-*.json).
PLAN_SPEC = [{"type": "function", "function": {"name": "plan", "description": "Give the ordered steps of the task", "parameters": {
    "type": "object", "required": ["steps"], "properties": {"steps": {"type": "array", "items": {
        "type": "object", "required": ["do"], "properties": {
            "do": {"type": "string", "description": "one concrete action"},
            "needs": {"type": "array", "items": {"type": "integer"}, "description": "numbers of the earlier steps it depends on"},
            "check": {"type": "string", "description": "how to verify it: app:PACKAGE (in front), text:WORDS (on the screen), "
                                                       "file:PATH (exists), or none"}}}}}}}}]
TASK_PLAN = ("Task: {goal}\n\nCall the plan tool with the steps that reach it, in order: 1 to 6 short steps, each one concrete "
             "action for your tools ({tools}). In needs, give the numbers of the earlier steps a step depends on. In check, "
             "say what proves the step is done when it can be seen (an app in front, words on the screen, a file). "
             "A simple task is a single step.")
TASK_STEP = ("Overall task: {goal}\nPlan:\n{plan}\n\nDo step {n} now: {do}\nUse your tools, read their results and fix errors.{again} "
             "End with one line: DONE: what the tools showed, or FAILED: why.")
FAILED_OUT = re.compile(r"error|denied|refused|not run|exit [1-9]")  # how a tool result starts when nothing was achieved


def task_file(tid):
    return DATA / "tasks" / f"{tid}.json"


def save_task(task):
    path = task_file(task["id"])
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    # the goal stays whole while the task can still be resumed (a step may need the password it gives); run_task masks
    # it at the end. The steps never keep a typed password
    tmp.write_text(json.dumps({**task, "steps": untyped(task["steps"])}, ensure_ascii=False, indent=1))
    os.replace(tmp, path)  # never half a file, even if Android kills Termux while it writes


def saved_tasks():
    d, out = DATA / "tasks", []
    for f in sorted(d.glob("*.json")) if d.exists() else []:
        try:
            t = json.loads(f.read_text())
            out += [t] if isinstance(t, dict) and isinstance(t.get("steps"), list) and "id" in t else []
        except (OSError, ValueError):
            pass
    return out


def make_plan(conf, head, goal, tools):
    """The steps of a task: the model's plan tool call; else the numbered lines of its answer; else the task as one step.
    A step without "needs" depends on the step before it (a failure then stops what follows, unless the model said the
    step stands alone with an empty list)."""
    ask = TASK_PLAN.format(goal=goal, tools=", ".join(n for n in tools if policy(conf, n) != "off" or n == "android"))
    text, calls = complete(conf, head + [{"role": "user", "content": ask}], PLAN_SPEC)
    print()
    raw = []
    for c in calls:
        try:
            raw = raw or (json.loads(c["args"]).get("steps") if c["name"] == "plan" else None) or []
        except (ValueError, AttributeError):
            pass
    if not isinstance(raw, list) or not raw:
        raw = [{"do": m.group(1)} for m in re.finditer(r"(?m)^\s*\d+[.)]\s+(.+)$", text)]
    steps = []
    for item in raw[:8]:
        do = item.get("do") if isinstance(item, dict) else item
        if not isinstance(do, str) or not do.strip():
            continue
        n, needs = len(steps) + 1, item.get("needs") if isinstance(item, dict) else None
        needs = (sorted({int(x) for x in needs if str(x).isdigit() and 0 < int(x) < n}) if isinstance(needs, list)
                 else [n - 1] if n > 1 else [])
        check = item.get("check") if isinstance(item, dict) and isinstance(item.get("check"), str) else ""
        steps.append({"n": n, "do": re.sub(r"\s+", " ", CTRL.sub("", do)).strip()[:300], "needs": needs, "status": "todo",
                      "result": "", "tries": 0, "trace": [], "check": re.sub(r"\s+", " ", CTRL.sub("", check)).strip()[:200]})
    return steps or [{"n": 1, "do": goal, "needs": [], "status": "todo", "result": "", "tries": 0, "trace": []}]


def task_report(task):
    """The report, written by the program from what the tools answered (never from the model's memory of it): each
    step, its calls with the start of their output, the files written with their size and SHA-256."""
    steps = task["steps"]
    done = sum(x["status"] == "done" for x in steps)
    lines = [f"# Task {task['id']}", "", f"Goal: {task['goal']}", f"Status: {task['status']} ({done} of {len(steps)} steps done)",
             f"Started {task['created']}, ended {task.get('ended', '-')}, model {task.get('model', '?')}", ""]
    files = {}
    for x in steps:
        lines += [f"## Step {x['n']} [{x['status']}] {x['do']}",
                  f"Needs: {', '.join(map(str, x['needs'])) or 'nothing'}. Tries: {x['tries']}. Result: {x['result'] or '-'}", ""]
        for c in x["trace"]:
            first = " / ".join(l.strip() for l in c["out"].splitlines()[:3] if l.strip())
            lines.append(f"- `{c['tool']} {c['args']}` -> {first[:240]}")
            try:
                path = json.loads(c["args"]).get("path") if c["tool"] == "write_file" and c["out"].startswith("wrote") else None
                if path:
                    files[c["out"].split(" to ", 1)[1].strip()] = None
            except (ValueError, AttributeError, IndexError):
                pass
        lines.append("")
    if files:
        lines.append("## Files written")
        for f in files:
            try:
                data = Path(f).read_bytes()
                lines.append(f"- {tilde(f)}: {len(data)} bytes, sha256 {hashlib.sha256(data).hexdigest()}")
            except OSError:
                lines.append(f"- {tilde(f)}: not there any more")
    return "\n".join(lines) + "\n"


def verify(conf, tools, check):
    """The program's own check of a step (app:PACKAGE in front, text:WORDS on the screen, file:PATH exists): None when
    it holds or there is none, else what is there instead. What the model says never counts by itself (13/11: it
    answered "42" without touching the calculator)."""
    kind, _, val = (check or "").partition(":")
    kind, val = kind.strip().lower(), val.strip()
    if kind not in ("app", "text", "file") or not val:
        return None
    if kind == "file":
        try:
            return None if allowed(val, conf).exists() else f"check failed: {val} does not exist"
        except PermissionError as e:
            return f"check failed: {e}"
    stop_check()
    if "ui" not in tools or policy(conf, "ui") == "off":
        return None
    seen = str(tools["ui"][0]("look"))
    if kind == "app":
        front = seen.splitlines()[0] if seen else ""
        return None if val.lower() in front.lower() else f"check failed: {val} is not in front ({front[:80]})"
    return None if val.lower() in seen.lower() else f"check failed: {val!r} is not on the screen"


def run_pending(conf, task, tools):
    """The call a task was parked on (NeedsApproval): run now if the owner approved it (zion passes its digest), else
    the step is told it was refused. Either way the step goes on from there."""
    p = task.pop("pending", None)
    if not p:
        return
    x = task["steps"][p["step"] - 1]
    if p["digest"] in conf.get("_approved", ()):
        out = guard(p["call"]["name"], call_tool(p["call"]["name"], p["call"]["args"], conf, tools), conf)
        conf.setdefault("_done", {})[p["digest"]] = out
        x["trace"].append({"tool": p["call"]["name"], "args": untyped(json.dumps(p["call"]["args"], ensure_ascii=False))[:300],
                           "out": untyped(out)[:400]})
        x["note"] = f"\nWith the owner's approval, OPERATOR already did: {p['what']} -> {out[:200]}"
    else:  # refused, or no answer before the request expired
        x["note"] = f"\nThe owner did not approve: {p['what']}. Do not try it again, nor another way."
        conf.setdefault("_denied", set()).add(p["digest"])


def run_task(conf, task, head, specs, tools):
    """Runs every step still to do, in order. A step whose needs did not succeed is not tried. A failed step is tried
    once more, told why. Saved before and after each step and after each tool round: --task-resume goes on from there.
    With zion: a call the owner must approve parks the task (NeedsApproval, status waiting); an emergency stop or a
    lost server leaves the step to do again (Stopped, ServerError); the step's check is run by the program."""
    steps, limits = task["steps"], conf["zion"]["limits"]
    task.setdefault("deadline", time.time() + 60 * limits["task_minutes"])
    if task.get("tainted"):
        conf["_tainted"] = task["tainted"]
    for x in steps:
        if x["status"] in ("doing", "waiting"):  # Termux closed, phone restarted, stop, or parked for approval
            x["status"], x["result"] = "todo", "interrupted"
    run_pending(conf, task, tools)
    for x in steps:
        if x["status"] != "todo":
            continue
        missing = [n for n in x["needs"] if steps[n - 1]["status"] != "done"]
        if missing or time.time() > task["deadline"]:
            x["status"], x["result"] = "blocked", ("not tried: needs step " + ", ".join(map(str, missing)) if missing
                                                   else "not tried: the task's time limit was reached")
            print(f"\n[step {x['n']}/{len(steps)} blocked] {x['do']}")
            save_task(task)
            continue
        why = "\nAn earlier try of this step was interrupted: look at what is already there before doing it again." if x["result"] == "interrupted" else ""
        why += x.pop("note", "")
        for _ in (1, 2):
            x["status"], x["tries"] = "doing", x["tries"] + 1
            save_task(task)
            plan = "\n".join(f"{y['n']}. [{y['status']}] {y['do']}" + (f" -> {y['result'][:120]}" if y["status"] in ("done", "failed") else "")
                             for y in steps)
            msgs = head + [{"role": "user", "content": TASK_STEP.format(goal=task["goal"], plan=plan, n=x["n"], do=x["do"], again=why)}]
            print(f"\n[step {x['n']}/{len(steps)}, try {x['tries']}] {x['do']}")
            conf["_trace"], start = x["trace"], len(x["trace"])
            conf["_said"] = task.get("said", task["goal"])
            conf["_deadline"] = min(task["deadline"], time.time() + 60 * limits["step_minutes"])
            try:
                turn(conf, msgs, specs, tools, lambda: save_task(task))
                said = re.sub(r"\s+", " ", str(msgs[-1].get("content") or "")).strip()
            except NeedsApproval as e:
                x["status"], task["status"], task["pending"] = "waiting", "waiting", {**e.args[0], "step": x["n"]}
                task["tainted"] = conf.get("_tainted")
                save_task(task)
                raise
            except (ServerError, Stopped) as e:  # not the step's fault: it is done again when the task goes on
                x["status"], x["result"], x["tries"] = "todo", "interrupted", x["tries"] - 1
                task["tainted"] = conf.get("_tainted")
                save_task(task)
                raise
            finally:
                conf.pop("_trace", None)
                conf.pop("_deadline", None)
            ran = x["trace"][start:]
            failed = bool(re.search(r"\bFAILED\b", said)) or not said or (ran and all(FAILED_OUT.match(c["out"]) for c in ran))
            x["result"] = (said or "no answer")[:400] + (" [every tool call of this step failed]" if failed and "FAILED" not in said and said else "")
            if not failed and (no := verify(conf, tools, x.get("check"))):
                failed, x["result"] = True, f"{no} (the model said: {said[:200]})"
            x["status"] = "failed" if failed else "done"
            task["tainted"] = conf.get("_tainted")
            save_task(task)
            if not failed:
                break
            why = f"\nA first try failed ({x['result'][:160]}): try another way."
    done = sum(x["status"] == "done" for x in steps)
    task["status"] = "done" if done == len(steps) else "partial" if done else "failed"
    task["ended"] = time.strftime("%Y-%m-%d %H:%M:%S")
    task["goal"], task["steps"] = untyped(secretless(task["goal"])), untyped(steps)  # over: nothing left to resume
    task.pop("said", None)
    report = task_file(task["id"]).with_suffix(".md")
    task["report"] = str(report)
    save_task(task)
    report.write_text(task_report(task))
    print(f"\ntask {task['status']}: {done} of {len(steps)} steps done. Report with what each tool showed: {tilde(report)}")
    return task


# ---- the ZION ZERO launcher's "ai" screen: OPERATOR as a background service (seeker-ai --serve) ----
# 13/11, "ia c'est réponse humaine, terminal c'est termux": the conversation is shown by the launcher itself,
# outside Termux; this service writes the answers, with the terminal's instructions, notes and tools, started by
# Termux's job scheduler (no Termux window). It listens on 127.0.0.1 only and answers only the key it gave the launcher.
LAUNCHER = "zero.seeker.launcher"
BUSY_SAY = "L'IA est occupée par une mesure en cours sur le téléphone. Réessaie un peu plus tard."
# the end of a /chat answer: END when the service finished it; FAIL first when what follows is the service's own
# sentence, not the model's (the launcher shows it aside and keeps it out of the conversation). No END: it was cut
END, FAIL = "\x04", "\x15"


def send_key(key, port):
    """Hands the key to the launcher: an explicit broadcast that Android delivers to the launcher only, and that the
    launcher accepts only from Termux (its receiver requires Termux's own signature permission; termux-am runs as Termux).
    -f 0x20: delivered even to a launcher that has not run since it was installed."""
    try:
        r = subprocess.run(["am", "broadcast", "-n", f"{LAUNCHER}/.AiToken", "-a", f"{LAUNCHER}.AI_TOKEN", "-f", "0x20",
                            "--es", "token", key, "--ei", "port", str(port)], stdout=subprocess.PIPE,
                           stderr=subprocess.STDOUT, text=True, timeout=60, stdin=subprocess.DEVNULL)
        done = r.returncode == 0 and "Broadcast" in r.stdout  # am prints "(has extras)", never their values
        sys.stderr.write(f"{time.strftime('%F %T')} key sent to the launcher: {'ok' if done else plain(r.stdout[-200:])}\n")
    except subprocess.TimeoutExpired:  # never its message: it holds the whole command, key included
        sys.stderr.write(f"{time.strftime('%F %T')} key NOT sent to the launcher: am did not answer within 60 s\n")
    except OSError as e:
        sys.stderr.write(f"{time.strftime('%F %T')} key NOT sent to the launcher: {e.strerror}\n")


def serve_conf():
    """The terminal's configuration, for a person reading the launcher's screen. That screen cannot show an approval
    question: what would ask is not offered to the model at all (and confirm() answers no, see serve())."""
    conf = load_conf()
    conf["_owner_ui"] = conf["tools"].get("ui")  # "off" written by the owner stays off, even with the drive switch on
    off = lambda d: {k: "off" if v == "ask" else v for k, v in d.items()}
    conf["levels"], conf["tools"], conf["android_policy"] = off(conf["levels"]), off(conf["tools"]), off(conf["android_policy"])
    conf["_human"], conf["_serve"], conf["show_speed"] = True, True, False
    conf["_unattended"] = True  # nobody to ask: the owner's policy (apps, classes) decides what the screen tool may do
    return conf


def serve_state(conf):
    """What the launcher's screen says before a question: busy, ready, sleeping, loading, stopped (the next question
    starts llama-server), or blocked (another app answers on llama-server's port: see ensure_server)."""
    if held():
        return "busy"
    url = conf["server"]
    if server_up(url):
        if PROC.exists() and not port_pids(url.rsplit(":", 1)[1]):
            return "blocked"
        return "sleeping" if (get_json(url + "/props") or {}).get("is_sleeping") else "ready"
    return "loading" if port_pids(url.rsplit(":", 1)[1]) else "stopped"


def info():
    """What the launcher's sections show about OPERATOR: short lines, newest first, no password (see secretless)."""
    conf, rows = load_conf(), lambda f, n: f.read_text(errors="replace").splitlines()[-n:][::-1] if f.exists() else []
    hist = []
    for line in rows(DATA / "history.jsonl", 12):
        try:
            h = json.loads(line)
            hist.append(f"{h['t'][5:16]} {h['mode']}: {secretless(h['prompt'])[:70]}" + (f" [{', '.join(h['tools'][:6])}]" if h.get("tools") else ""))
        except (ValueError, KeyError, TypeError):
            pass
    return {"tasks": [f"{t['id'][4:13]} {t.get('status', '?')} {sum(x.get('status') == 'done' for x in t['steps'])}/{len(t['steps'])} "
                      f"{untyped(secretless(str(t.get('goal', ''))))[:60]}" for t in saved_tasks()[-10:][::-1]],
            "memory": [secretless(l)[:160] for l in rows(DATA / "memory.md", 15)],
            "tools": [f"{n}: {policy(conf, n)}" for n in TOOL_LEVEL] + [f"android {k}: {policy(conf, 'android', k)}" for k in conf["android_actions"]],
            "history": hist, "firewall": net_blocked()}


def signed(key, what, nonce, body=b""):
    """The proof that both sides hold the key, which never travels after send_key: the launcher signs each question
    ("chat"), this service signs its answer ("answer"), each over a fresh nonce of the launcher. So an app that took the
    port while the service was down learns nothing from the launcher, and the launcher shows nothing it says."""
    return hmac.new(key.encode(), f"{what}\n{nonce}\n".encode() + body, hashlib.sha256).hexdigest()


def chat_drive(raw):
    """True when the launcher's signed question says its owner turned on "the ai may drive apps" (android section)."""
    try:
        return json.loads(raw).get("drive") is True
    except (ValueError, AttributeError):
        return False


def chat_messages(raw):
    """The launcher's conversation, checked: user and assistant texts only, ending with the question. None if not."""
    try:
        msgs = json.loads(raw)["messages"]
    except (ValueError, KeyError, TypeError):
        return None
    ok = (isinstance(msgs, list) and 0 < len(msgs) <= 40 and all(
        isinstance(m, dict) and m.get("role") in ("user", "assistant") and isinstance(m.get("content"), str) for m in msgs)
        and msgs[-1]["role"] == "user")
    return [{"role": m["role"], "content": m["content"]} for m in msgs] if ok else None


class ServeOut:
    """sys.stdout during one answer of the service: every piece goes to the launcher at once. Writing fails when the
    launcher left (screen closed): the answer then stops, and so does llama-server's generation."""
    def __init__(self, w):
        self.w = w

    def write(self, s):
        if s:
            self.w.write(s.encode())
        return len(s)

    def flush(self):
        self.w.flush()


def answer(msgs, out, drive=False):
    """One question of the launcher's screen: the terminal's turn (instructions, notes, tools), its plain answer
    written to out. Never loads a model while a job holds the memory (see BUSY).
    drive: the owner turned on "the ai may drive apps" in the launcher, which says so in each signed question. The
    screen tool is then offered without asking, since that screen cannot ask; what it never does (wallet, locked
    phone, Android's own questions, a password the request does not give) holds as everywhere."""
    conf, question = serve_conf(), msgs[-1]["content"]
    if drive and conf["_owner_ui"] != "off":
        conf["tools"] = {**conf["tools"], "ui": "auto"}
    try:
        if held():  # a job started since do_POST looked
            out.write(FAIL + BUSY_SAY + END)
            return log_task("serve", question, [], "busy")
        if STOP.exists():
            out.write(FAIL + "ZION est à l'arrêt d'urgence. Pour reprendre : « reprendre ZION » dans le lanceur, ou zion-stop --resume dans Termux." + END)
            return log_task("serve", question, [], "emergency stop")
        model = Path(conf["model"]).expanduser()
        conf["_model"] = str(model)
        tools = make_tools(conf)
        specs = tool_specs(conf, tools)
        head = [{"role": "system", "content": system_text(conf, True)}] + notes_pair(conf)
        if conf["prefix_cache"]:
            conf["_prefix"] = (model, head, specs)
        try:
            if ensure_server(conf, model) and conf.get("_prefix"):  # a cold server: the fixed start, restored from disk
                prefix_cache(conf, *conf["_prefix"])
            with contextlib.redirect_stdout(out):
                used = turn(conf, head + msgs, specs, tools)
            log_task("serve", question, used)
            if any(u.startswith("ui:") and u != "ui:look" for u in used) and rish_path():
                # OPERATOR left the launcher to work in other apps: its answer is read on the "ai" screen
                run([rish_path(), "-c", f"am start -n {LAUNCHER}/.Main --es screen ai"], timeout=20)
            out.write(END)
        except SystemExit as e:  # ensure_server could not start llama-server, or met another app: why is in the log
            sys.stderr.write(f"{time.strftime('%F %T')} {e}\n")
            log_task("serve", question, [], f"not started: {str(e)[:80]}")
            out.write(FAIL + ("Une autre application occupe la place du modèle de l'IA : l'IA refuse de lui parler."
                              if "another app" in str(e) else "L'IA n'a pas pu démarrer. Réessaie dans un moment.") + END)
        except ServerError as e:
            sys.stderr.write(f"{time.strftime('%F %T')} server error: {e}\n")
            log_task("serve", question, [], f"server error {str(e)[:80]}")
            out.write(FAIL + "L'IA n'a pas pu finir sa réponse. Réessaie." + END)
        except Stopped:
            log_task("serve", question, [], "emergency stop")
            out.write(FAIL + "Arrêt d'urgence : l'IA s'est arrêtée au milieu de sa réponse." + END)
    except OSError as e:  # the launcher left before the end: nobody to tell
        sys.stderr.write(f"{time.strftime('%F %T')} answer not delivered: {e}\n")


def serve():
    """seeker-ai --serve. Every request carries X-Zion-Nonce (16-64 characters) and X-Zion-Auth, every answer X-Zion-Proof:
    GET /status: auth signed(key, "status", nonce) -> {"state": ...} (serve_state), proof signed(key, "state", nonce).
    GET /info: auth signed(key, "info", nonce) -> info() as JSON, proof signed(key, "info-ok", nonce).
    POST /chat, body {"messages": [{"role": "user" | "assistant", "content": ...}, ...]}: auth signed(key, "chat", nonce,
    body), nonce used once -> proof signed(key, "answer", nonce), then the answer as plain text, streamed as it is
    written. The launcher sends a conversation only after a /status whose proof holds. One answer at a time. A bad
    signature gets 401, and the launcher gets the key again."""
    conf = load_conf()
    port = int(conf["serve_port"])
    DATA.mkdir(parents=True, exist_ok=True)
    sys.stderr = open(DATA / "serve.log", "a", buffering=1)  # no terminal: tool steps and errors go to this log
    os.environ["SEEKER_AI_CONFIRM"] = "no"  # an approval never waits on a terminal (see serve_conf)
    key, last_resend, one, seen, one_nonce = secrets.token_urlsafe(24), [0.0], threading.Lock(), set(), threading.Lock()

    class Handler(http.server.BaseHTTPRequestHandler):
        def log_message(self, *a):
            pass

        def reply(self, code, text, ctype="text/plain; charset=utf-8", proof=None):
            body = text.encode()
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            if proof:
                self.send_header("X-Zion-Proof", proof)
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def resend(self):
            if time.time() - last_resend[0] > 10:  # the launcher may hold the key of an earlier start
                last_resend[0] = time.time()
                threading.Thread(target=send_key, args=(key, port), daemon=True).start()
            self.reply(401, "unknown key")

        def do_GET(self):
            what = {"/status": "status", "/info": "info"}.get(self.path)
            if not what:
                return self.reply(404, "not found")
            nonce = self.headers.get("X-Zion-Nonce", "")
            if not (16 <= len(nonce) <= 64 and hmac.compare_digest(self.headers.get("X-Zion-Auth", "").encode(),
                                                                   signed(key, what, nonce).encode())):
                return self.resend()
            if what == "info":  # tasks, memory, tools, history, firewall: for the launcher's sections
                return self.reply(200, json.dumps(info(), ensure_ascii=False), "application/json", signed(key, "info-ok", nonce))
            self.reply(200, json.dumps({"state": serve_state(serve_conf())}), "application/json", signed(key, "state", nonce))

        def do_POST(self):
            if self.path != "/chat":
                return self.reply(404, "not found")
            try:
                n = int(self.headers.get("Content-Length") or 0)
            except ValueError:
                n = 0
            if not 0 < n <= 200_000:
                return self.reply(400, "bad request")
            raw, nonce = self.rfile.read(n), self.headers.get("X-Zion-Nonce", "")
            with one_nonce:
                fresh = 16 <= len(nonce) <= 64 and nonce not in seen
                good = fresh and hmac.compare_digest(self.headers.get("X-Zion-Auth", "").encode(),
                                                     signed(key, "chat", nonce, raw).encode())
                if good:
                    seen.add(nonce)  # a signed question replayed later gets 401
            if not good:
                return self.resend()
            msgs = chat_messages(raw)
            if msgs is None:
                return self.reply(400, "bad request")
            if held():  # decided before the answer starts: the launcher says it, and the question goes back in its box
                return self.reply(503, "busy")
            if not one.acquire(timeout=1):
                return self.reply(409, "busy")
            try:
                self.send_response(200)
                self.send_header("Content-Type", "text/plain; charset=utf-8")
                self.send_header("X-Zion-Proof", signed(key, "answer", nonce))
                self.end_headers()
                answer(msgs, ServeOut(self.wfile), chat_drive(raw))
            finally:
                one.release()

    try:
        httpd = http.server.ThreadingHTTPServer(("127.0.0.1", port), Handler)
    except OSError as e:  # the job runs this every 15 minutes: already running is the usual case
        print(f"seeker-ai --serve: 127.0.0.1:{port} already taken ({e.strerror}), not started")
        return
    sys.stderr.write(f"{time.strftime('%F %T')} serving the launcher on 127.0.0.1:{port}, pid {os.getpid()}\n")
    send_key(key, port)
    httpd.serve_forever()


def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("prompt", nargs="*")
    ap.add_argument("-f", "--file", action="append", default=[])
    ap.add_argument("--resume", action="store_true", help="continue the last saved chat")
    ap.add_argument("--chat", action="store_true", help="conversation only, no tools")
    ap.add_argument("--models", action="store_true", help="list the models")
    ap.add_argument("--use", metavar="NAME", help="make a model the default")
    ap.add_argument("--model", metavar="NAME", help="use a model for this run only")
    ap.add_argument("--start", action="store_true", help="start llama-server and exit")
    ap.add_argument("--stop", action="store_true", help="stop llama-server (frees its memory)")
    ap.add_argument("--status", action="store_true", help="server, model, memory, speed, permissions, last tasks")
    ap.add_argument("--remote", action="store_true", help='use the server of config key "remote" (e.g. the Mac), not the phone\'s')
    ap.add_argument("--tech", action="store_true", help="technical display on a screen too: speed lines, tool outputs, Markdown")
    ap.add_argument("--serve", action="store_true", help='background service of the ZION ZERO launcher\'s "ai" screen')
    ap.add_argument("--task", action="store_true", help="plan the request, run it step by step, keep the progress, end with a report")
    ap.add_argument("--task-resume", nargs="?", const="", metavar="ID", help="go on with an interrupted task (the last one)")
    ap.add_argument("--tasks", action="store_true", help="list the tasks and their state")
    ap.add_argument("--unattended", action="store_true", help="nobody at the terminal: the owner's policy decides (zion)")
    ap.add_argument("--task-id", metavar="ID", help="the id of a new --task (zion chooses it)")
    ap.add_argument("--apps", metavar="PKG,PKG", default="", help="apps this task may drive besides the policy's")
    ap.add_argument("--policy", action="store_true", help="print the owner's policy as zion reads it")
    a = ap.parse_args()
    if a.serve:  # before the busy check below: the service stays up and answers "busy" itself
        return serve()
    conf = load_conf()
    if a.policy:
        return print(json.dumps(conf["zion"], ensure_ascii=False))
    if a.unattended or os.environ.get("ZION_UNATTENDED") == "1":
        os.environ["SEEKER_AI_CONFIRM"] = "no"  # nothing ever waits on a terminal
        conf["_unattended"], conf["_can_park"] = True, bool(a.task or a.task_resume is not None)
        conf["_approved"] = set(filter(None, os.environ.get("ZION_APPROVED", "").split(",")))
        conf["_denied"] = set(filter(None, os.environ.get("ZION_DENIED", "").split(",")))
    conf["_apps"] = {p for p in a.apps.split(",") if PKG.fullmatch(p)}
    if a.task_id and not re.fullmatch(r"[0-9A-Za-z_-]{6,64}", a.task_id):
        sys.exit("--task-id: 6 to 64 letters, digits, _ or -")
    # a person reads the screen: plain answers (see HUMAN); scripts, pipes and the self-test keep the technical display
    conf["_human"] = sys.stdout.isatty() and not a.tech
    if conf["_human"]:
        conf["show_speed"] = False
        SAY.update(SAY_HUMAN)
    if a.remote:
        conf["server"], conf["_remote_model"] = conf["remote"]["server"].rstrip("/"), conf["remote"]["model"]
        host = urllib.parse.urlsplit(conf["server"]).hostname or ""
        if host not in ("127.0.0.1", "localhost", "::1") and not conf["remote"].get("allow_lan"):
            sys.exit(f"remote server {plain(host)} refused: over plain HTTP any device on the network could read the chat and "
                     f'answer in OPERATOR\'s place. Use the adb reverse link (comment above "remote" in seeker-ai), or add '
                     f'"allow_lan": true to "remote" in {tilde(CONF_PATH)} if you accept that.')
        if not conf["_remote_model"]:
            sys.exit(f'set "remote": {{"server": ..., "model": ...}} in {tilde(CONF_PATH)} (see the comment in seeker-ai)')
    if a.tasks:
        for t in saved_tasks()[-20:]:
            done = sum(x.get("status") == "done" for x in t["steps"])
            print(f"{t['id']}  {t.get('status', '?'):8} {done}/{len(t['steps'])} steps  {plain(secretless(str(t.get('goal', ''))))[:70]}")
        return
    if (a.stop or a.use or not (a.remote or a.models or a.status)) and (why := held()):  # loads or stops a model here
        if a.prompt or a.start or a.stop or a.use or not sys.stdin.isatty():
            sys.exit(why)
        pause(why)
    if a.models:
        default = Path(conf["model"]).expanduser().resolve()
        for m in models(conf):
            print(f"{'*' if m.resolve() == default else ' '} {m.name:55} {m.stat().st_size / 1e9:5.2f} GB")
        return
    if a.use:
        m = find_model(conf, a.use)
        save_conf(model=tilde(m))
        print(f"default model: {m.name} (previous config backed up next to {tilde(CONF_PATH)})")
        if server_up(conf["server"]) and stop_server():
            print("llama-server stopped: it restarts with this model on next use")
        return
    if a.stop:
        print(f"stopped {stop_server()} llama-server process(es)")
        return
    if a.status:
        status(conf)
        return
    model = Path(conf["_remote_model"]) if a.remote else find_model(conf, a.model) if a.model else Path(conf["model"]).expanduser()
    conf["_model"] = str(model)
    try:  # -f paths start where you are, not in the agent's work folder, and are read before the model loads
        files = attach([str(Path(f).expanduser().resolve()) for f in a.file], conf)
    except OSError as e:
        sys.exit(f"cannot read: {e}")
    if a.remote:
        if get_json(conf["server"] + "/v1/models", timeout=5) is None:
            sys.exit(f"remote server not reachable at {conf['server']} (on the Mac: adb reverse tcp:8081 tcp:11434, Ollama running)")
        started = False
    else:
        try:
            started = ensure_server(conf, model)
        except KeyboardInterrupt:
            sys.exit("\n(stopped; llama-server may still be loading in the background: seeker-ai --stop frees it)")
    if a.start:
        print(f"online: {model.name} on {conf['server']}")
        return
    agent = not a.chat
    tools = make_tools(conf)
    specs = tool_specs(conf, tools) if agent else []
    messages = [{"role": "system", "content": system_text(conf, agent)}]
    mode = "agent" if agent else "chat"
    if not a.remote and conf["prefix_cache"]:
        conf["_prefix"] = (model, messages[:1] + notes_pair(conf), specs)
    stdin_text = None if sys.stdin.isatty() else sys.stdin.read()
    if started and conf.get("_prefix"):  # a cold server: restore the prefix from disk, or compute and save it
        if a.prompt or stdin_text:
            w = Waiting("preparing")
            prefix_cache(conf, *conf["_prefix"])
            w.stop()
        else:  # while you type your first message
            conf["_warm"] = threading.Thread(target=prefix_cache, args=(conf, *conf["_prefix"]), daemon=True)
            conf["_warm"].start()
    if a.task or a.task_resume is not None:
        if not agent:
            sys.exit("--task needs the tools: not with --chat")
        head = messages + notes_pair(conf)
        if conf.get("_warm"):  # the fixed start is still being computed: the plan call must not slip into it
            conf.pop("_warm").join()
        try:
            if a.task_resume is not None:
                todo = [t for t in saved_tasks() if t.get("status") in ("running", "planning", "waiting") and t["id"].startswith(a.task_resume)]
                if not todo:
                    sys.exit("no interrupted task" + (f" starts with {a.task_resume}" if a.task_resume else "") + " (see seeker-ai --tasks)")
                task = todo[-1]
                print(f"resuming task {task['id']}: {plain(secretless(task['goal']))[:100]}")
            else:
                goal = "\n".join(filter(None, [files, " ".join(a.prompt)]))
                if not goal:
                    sys.exit('usage: seeker-ai --task "what to do"')
                task = {"id": a.task_id or time.strftime("%Y%m%d-%H%M%S"), "goal": goal, "said": " ".join(a.prompt),
                        "created": time.strftime("%Y-%m-%d %H:%M:%S"), "status": "planning", "model": Path(conf["_model"]).name, "steps": []}
                save_task(task)
            if not task["steps"]:
                task["steps"] = make_plan(conf, head, task["goal"], tools)
                if conf.get("_prefix"):  # the plan call had its own tool list: the steps' fixed start comes back from disk
                    prefix_cache(conf, *conf["_prefix"])
            task["status"] = "running"
            save_task(task)
            for x in task["steps"]:
                print(f"  {x['n']}. {x['do']}" + (f"  (needs {', '.join(map(str, x['needs']))})" if x["needs"] else ""))
            task = run_task(conf, task, head, specs, tools)
            log_task("task", task["goal"], [c["tool"] for x in task["steps"] for c in x["trace"]],
                     None if task["status"] == "done" else task["status"])
        except KeyboardInterrupt:
            sys.exit("\n(stopped: seeker-ai --task-resume goes on with it)")
        except NeedsApproval as e:  # exit codes read by zion: 4 parked, 5 emergency stop, 6 server lost (resumable)
            print(f"\n[waiting for the owner's approval] {plain(e.args[0]['what'])}", file=sys.stderr)
            sys.exit(4)
        except Stopped as e:
            print(f"\n[emergency stop] {plain(str(e))}", file=sys.stderr)
            sys.exit(5)
        except ServerError as e:
            print(f"\n[server error] {plain(str(e))}\n(seeker-ai --task-resume goes on with it)", file=sys.stderr)
            sys.exit(6)
        sys.exit(0 if task["status"] == "done" else 3)
    if a.prompt or stdin_text:
        prompt = " ".join(a.prompt)
        piped = f"<stdin>\n{stdin_text}\n</stdin>" if stdin_text else ""
        messages += notes_pair(conf)
        messages.append({"role": "user", "content": "\n".join(filter(None, [files, piped, prompt]))})
        conf["_said"] = prompt
        try:
            log_task(mode, prompt, turn(conf, messages, specs, tools))
        except KeyboardInterrupt:
            log_task(mode, prompt, [], "stopped by the user")
            sys.exit("\n(stopped)")
        except ServerError as e:
            log_task(mode, prompt, [], f"server error {str(e)[:80]}")
            sys.exit(f"\n[server error] {plain(str(e))}")
        except Stopped as e:
            log_task(mode, prompt, [], "emergency stop")
            sys.exit(f"\n[emergency stop] {plain(str(e))}: nothing more was done (zion-stop --resume to go on)")
        return
    sessions = DATA / "sessions"
    session = sessions / time.strftime("%Y%m%d-%H%M%S.json")

    def resume(path):
        nonlocal session
        loaded = load_session(path)
        if loaded is None:
            print(f"(cannot read {path.name}: not resumed)")
            return False
        session = path
        del messages[1:]
        messages.extend(loaded)
        print(f"(resumed {path.name}, {len(messages) - 1} messages)"
              + ("\n(this task was interrupted before its end: say \"continue\" and OPERATOR goes on)" if interrupted(messages) else ""))
        return True
    if a.resume:
        for path in reversed(saved_sessions()):  # the newest one that can be read
            if resume(path):
                break
    pending = files
    where = f"remote {conf['server']}" if a.remote else "offline"
    print("IA prête, hors ligne. Écris ta question. Pour quitter : /exit" if conf["_human"] else
          f"OPERATOR {mode}, {model.name}, {where}. /file PATH  /tools  /memory  /history  /resume [N]  /reset  /exit")
    while True:
        try:
            line = input("> ").strip()
        except (EOFError, KeyboardInterrupt):
            print()
            return
        if not line:
            continue
        if line in ("/exit", "/quit"):
            return
        if line == "/reset":
            del messages[1:]
            session = sessions / time.strftime("%Y%m%d-%H%M%S.json")
            print("(new conversation)")
            continue
        if line == "/tools":
            status(conf)
            continue
        if line == "/history":
            for i, path in enumerate(reversed(saved_sessions()[-10:]), 1):
                print(session_line(i, path))
            continue
        if line == "/resume" or line.startswith("/resume "):
            arg, saved = line[8:].strip() or "1", saved_sessions()
            if not arg.isdigit() or not 1 <= int(arg) <= len(saved):
                print(f"(/resume N, with N from /history: 1 = the most recent of {len(saved)})")
                continue
            resume(saved[-int(arg)])
            continue
        if line == "/system":
            print(plain(messages[0]["content"]))
            continue
        if line == "/memory":
            mem = DATA / "memory.md"
            print(plain(mem.read_text()) if mem.exists() else "(empty)")
            continue
        if line == "/forget":
            if confirm("erase all long-term memory?"):
                (DATA / "memory.md").unlink(missing_ok=True)
                print("(memory erased)")
            continue
        if line.startswith("/file "):
            try:
                pending += "\n" + attach([line[6:].strip()], conf)
                print("(attached)")
            except (OSError, PermissionError) as e:
                print(f"(cannot read: {e})")
            continue
        if not a.remote and (why := held()):  # a job took the memory while this chat was open: never use its server
            print(why)
            continue
        if len(messages) == 1:
            messages += notes_pair(conf)
        request = {"role": "user", "content": (pending + "\n" + line).strip()}
        before = [dict(m) for m in messages]  # forget_oldest cuts and rewrites messages while the turn retries
        messages.append(request)
        pending = ""
        conf["_said"] = line
        try:
            log_task(mode, line, turn(conf, messages, specs, tools, lambda: save_session(session, messages)))
        except (KeyboardInterrupt, ServerError, Stopped) as e:  # keep the chat alive, without the unfinished request
            messages[:] = before
            error = ("stopped by the user" if isinstance(e, KeyboardInterrupt) else f"emergency stop: {e}" if isinstance(e, Stopped)
                     else f"server error {str(e)[:80]}")
            log_task(mode, line, [], error)
            print(f"\n({error}; this request is forgotten)" + ("" if isinstance(e, KeyboardInterrupt) else f"\n{e}"))
        save_session(session, messages)


if __name__ == "__main__":
    main()
