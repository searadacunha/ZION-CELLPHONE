def make_tools(conf):
    def t_read_file(path):
        p, n = allowed(path, conf), conf["max_tool_output"]
        with open(p, errors="replace") as f:  # a 4 GB video must not be read whole (Termux was killed for memory)
            text = f.read(n)
        size = p.stat().st_size
        return text if size <= n else text[:n - 200] + f"\n[... the file has {size:,} bytes: only its start was read]"

    def t_list_dir(path="."):
        return "\n".join(sorted(f"{x.name}/" if x.is_dir() else x.name for x in allowed(path, conf).iterdir()))

    def t_write_file(path, content):
        p = allowed(path, conf)
        p.parent.mkdir(parents=True, exist_ok=True)
        p.write_text(content)
        return f"wrote {len(content)} characters to {p}"

    def t_search(pattern, path="."):
        root = allowed(path, conf)
        argv = (["rg", "-n", "-S", "--max-count", "20", "--max-columns", "240", "-e", pattern, str(root)] if shutil.which("rg")
                else ["grep", "-rnI", "-m", "20", "--exclude-dir=.*", "-e", pattern, str(root)])
        out, keep = run(argv, timeout=60).split("\n", 1)[1].splitlines(), []
        for line in out:  # only hits in files the file tools may read (rg already skips hidden ones; denied folders too)
            try:
                allowed(line.split(":", 1)[0], conf)
                keep.append(line)
            except (PermissionError, OSError):
                pass
        return "\n".join(keep[:200]) or "no match"

    def t_git(args, repo="."):
        words, root = shlex.split(args), allowed(repo, conf)
        extra = ["--no-ext-diff", "--no-textconv"] if words[0] in ("diff", "show", "log") else []
        return run(["git", *GIT_SAFE, "-C", str(root), words[0], *extra, *words[1:]], timeout=180)

    def t_shell(command):
        return run(["bash", "-c", command], cwd=workdir(conf))

    def t_python(code):
        return run([sys.executable, "-c", code], cwd=workdir(conf))

    def t_fetch_url(url):
        if not url.startswith(("http://", "https://")):
            return "error: only http(s) URLs"
        opener = urllib.request.build_opener(SafeRedirect)
        with opener.open(urllib.request.Request(url, headers={"User-Agent": "seeker-ai"}), timeout=30) as r:
            body = r.read(2_000_000).decode(r.headers.get_content_charset() or "utf-8", "replace")
        body = re.sub(r"(?is)<(script|style).*?</\1>", " ", body)
        return html.unescape(re.sub(r"\s+", " ", re.sub(r"<[^>]+>", " ", body))).strip()

    def t_android(action, text="", title="", number="", path="", value="", package=""):
        if action == "open_url" and not text.startswith(("http://", "https://")):
            return "error: open_url needs an http(s) URL in text"
        if action == "install_apk" and not path.endswith(".apk"):
            return "error: install_apk needs the path of an .apk file"
        if action in ("screenshot", "photo") and not path:  # screencap runs as shell: it can write to shared storage only
            path = f"/sdcard/Pictures/seeker-ai-{int(time.time())}.{'png' if action == 'screenshot' else 'jpg'}"
        if action == "net_status" and not package:  # every app this journal blocked; value "reapply" = after a restart
            package = " ".join(net_blocked())
            if value == "reapply" and package:
                rish = rish_path()
                return run([rish, "-c", "cmd connectivity set-chain3-enabled true; " + "; ".join(
                    f"cmd connectivity set-package-networking-enabled false {q(x)}" for x in package.split()) + "; " + ANDROID[action][0]({"package": package})]) \
                    if rish else "error: needs Shizuku"
        elif action.startswith(("app_", "net_", "perm")):
            if not PKG.fullmatch(package):
                return "error: package must be an Android package name, e.g. org.fossify.gallery"
            if action not in ("app_info", "net_status", "permissions") and (PROTECTED.search(package) or CORE.match(package)):
                return f"refused: {package} is protected (Seed Vault, Solana, Android core, Termux, Shizuku or the launcher)"
        if action == "perm_revoke" and not re.fullmatch(r"android\.permission\.[A-Z_]+", value):
            return "error: value must be a permission name, e.g. android.permission.CAMERA (see action permissions)"
        a = {"text": text, "title": title, "number": number, "path": str(allowed(path, conf)) if path else "", "value": value,
             "package": package}
        build, _, backend = ANDROID[action]
        if backend == "api":
            return run(build(a), timeout=60)
        rish = rish_path()
        if not rish:
            return f"error: {action} needs Shizuku (start Shizuku, then run seeker-setup-shizuku)"
        if action == "net_block":  # a uid under 10000 is Android itself (system_server, phone, network stack): never cut off
            uid = re.search(rf"package:{re.escape(package)} uid:(\d+)", run([rish, "-c", f"pm list packages -U {q(package)}"]))
            if not uid or int(uid.group(1)) < 10000:
                return f"refused: {package} is not installed, or shares a system uid"
        out = run([rish, "-c", build(a)], timeout=120)
        if action in UNDO:  # every change is journaled with its undo, for you and for OPERATOR
            DATA.mkdir(parents=True, exist_ok=True)
            with open(DATA / "changes.tsv", "a") as f:
                f.write(f"{time.strftime('%F %T')}\t{action}\t{package}{' ' + value if action == 'perm_revoke' else ''}\tundo: {UNDO[action]}\t"
                        f"{' '.join(out.split())[:120]}\n")
        return out

    def t_system(command):
        rish = rish_path()
        if not rish:
            return "error: Shizuku is not set up (no rish). Start Shizuku, then run seeker-setup-shizuku."
        return run([rish, "-c", command])

    def t_ui(action, target="", text=""):
        rish = rish_path()
        if not rish:
            return "error: ui needs Shizuku (start Shizuku, then run seeker-setup-shizuku)"
        ui = conf.setdefault("_ui", {})  # the last screen the model read: tap and type name its numbered elements
        action, target, key = action.strip().lower(), target.strip(), target.strip().lower()

        def sh(cmd):
            out = run([rish, "-c", cmd], timeout=60)
            return run([rish, "-c", cmd], timeout=60) if "Request timeout" in out else out  # rish does, now and then

        def look():
            for _ in range(3):  # Android gives no tree in the middle of a transition: look again
                st = ui_parse(sh(UI_LOOK))
                if st["root"] is not None or st["locked"]:
                    break
                time.sleep(1)
            return st

        def gate(st, acting):
            """Why this screen may not be read (or, with acting, touched); None when it may. Not a permission level:
            it holds even when you approve."""
            owners = [x for x in (st["pkg"], st["win"], st["focus"]) if x]
            if st["locked"]:
                return "refused: the phone is locked. Only its owner unlocks it."
            if any(PROTECTED.search(x) for x in owners):
                return ("refused: this screen belongs to the wallet or the Seed Vault. OPERATOR neither reads nor touches it "
                        "(ui key back or ui key home leaves it).")
            if st["secure"]:
                return "refused: this app forbids capturing this window (FLAG_SECURE). OPERATOR does not read it."
            if acting and any(UI_CONSENT.match(x.split("/")[0]) for x in owners):
                return ("refused: on this screen Android asks the owner for a decision (permission, install, VPN, unlock...). "
                        "OPERATOR does not answer it: tell the user what it asks.")
            return None

        def show(st, before=None):
            """The screen as the model reads it, remembered for the next tap; or why it may not be read."""
            no = gate(st, False)
            if no or st["root"] is None:
                ui.clear()
                return no or "error: Android gave no screen content (try ui wait)"
            els, texts, _, scrolls = ui_elements(st["root"])
            desc = ui_describe(st, els, texts, scrolls)
            ui.update(els=els[:UI_MAX], desc=desc)
            return ("(the screen did not change: treat the action as not done)\n" if desc == before else "") + desc

        def pick(els):
            """The element the model named: by its number on the screen it read (still there, same label), or by its
            text. A sentence instead when it cannot be told: nothing is tapped on a guess."""
            exact = [e for e in els if e["label"].lower() == key]
            num = target[1:] if target.startswith("#") else target
            if num.isdigit() and (target.startswith("#") or not exact):  # a number, unless an element is named so (a key)
                seen = ui.get("els") or []
                if not 1 <= int(num) <= len(seen):
                    return f"error: no element {num} on the last screen read (ui look first). The screen now:"
                want = seen[int(num) - 1]
                same = [e for e in els if (e["kind"], e["label"], e["secret"]) == (want["kind"], want["label"], want["secret"])]
                here = [e for e in same if e["xy"] == want["xy"]]
                if not same or (len(same) > 1 and not here):
                    return "the screen changed since you read it: nothing was done. The screen now:"
                return (here or same)[0]
            name = json.dumps(target, ensure_ascii=False)
            hits = (exact or [e for e in els if key in e["label"].lower().split(" | ")]
                    or [e for e in els if key in e["label"].lower()]) if key else []
            if len(hits) != 1:
                return (f"error: {len(hits)} elements are named {name}: give the number. The screen now:" if hits
                        else f"error: nothing on the screen is named {name}. The screen now:")
            return hits[0]

        def scope(pkg):  # the owner's allowed apps, plus those he gave this task (zion add --apps)
            return "ordinary" if pkg in conf["zion"]["apps"] or pkg in conf.get("_apps", ()) else "outside_apps"

        def allow(cls, what, covers, replay):
            """None if this screen action may run. Nobody at the terminal: the owner's policy (permit). At the terminal:
            what destroys or pays is asked again, even after "yes to every screen action" or a policy on auto."""
            if conf.get("_unattended"):
                return permit(conf, cls, "ui", covers, what, replay)
            if cls in ("system", "payment") and not conf.get("_asked"):
                return None if confirm(f"\n[OPERATOR wants to] {plain(what)} ({cls})\nallow?") is True else "denied by the user"
            return None

        def open_app():
            m = re.fullmatch(r"settings(?:[ :]+(\w+))?", key)
            if m:
                page = UI_SETTINGS.get(m.group(1)) if m.group(1) else "SETTINGS"
                if not page:
                    return "error: settings pages: " + ", ".join(UI_SETTINGS)
                pkg, cmd = "com.android.settings", f"am start -a android.settings.{page}"
            else:
                apps, _, names = sh(f"{UI_APPS}; echo ZIONLABELS; cat {UI_LABELS} 2>/dev/null").partition("ZIONLABELS")
                comps = dict(l.strip().split("/", 1) for l in apps.splitlines() if re.fullmatch(r"\s*[\w.]+/[\w.$]+\s*", l))
                label = {k: v for k, _, v in (l.partition("\t") for l in names.splitlines()) if k in comps and v}
                hits = ([key] if key in comps else [k for k in comps if label.get(k, "").lower() == key]
                        or [k for k in comps if key and key in label.get(k, "").lower()]
                        or [k for k in comps if key and key.replace(" ", "") in k.lower()])
                if len(hits) != 1:
                    listed = ", ".join(sorted(f"{label[k]} ({k})" if k in label else k for k in (hits or comps)))
                    return clip(f"error: {'several apps match' if hits else 'no app matches'} {json.dumps(target, ensure_ascii=False)}. "
                                f"Give one of these packages: {listed}", 1500)
                pkg = hits[0]
                if PROTECTED.search(pkg):
                    # said in full: on the phone the model turned a bare refusal into "it is not installed" (13/11)
                    return ("refused: the wallet and the Seed Vault are installed, but OPERATOR never opens, reads or touches them. "
                            "Tell the user to open it themselves.")
                if UI_SELF.match(pkg) and pkg != LAUNCHER:
                    return "refused: OPERATOR does not open Termux or Shizuku: they hold its own rights."
                cmd = f"am start -a android.intent.action.MAIN -c android.intent.category.LAUNCHER -n {q(pkg + '/' + comps[pkg])}"
            tgt = key if m else pkg  # what opens the same screen again once approved
            no = allow(scope(pkg), f"open {tgt}", {"action": "open", "target": tgt, "app": pkg}, {"action": "open", "target": tgt})
            if no:
                return no
            out = sh(cmd)
            if not out.startswith("exit 0") or "Error" in out:
                return f"error: Android did not open it: {out[:300]}"
            time.sleep(1.5)
            st = look()
            return ("" if pkg in (st["pkg"], st["win"]) else f"({pkg} is not in front yet: ui wait)\n") + show(st)

        if action == "look":
            return show(look())
        if action == "open":
            return open_app() if key else "error: open needs an app name or package in target"
        if action == "wait":  # seconds, or a text to wait for (about 20 s at most)
            if re.fullmatch(r"\d+(\.\d+)?", target or "2"):
                time.sleep(min(float(target or 2), 15))
                return show(look())
            for _ in range(7):
                out = show(look())
                if key in out.lower():
                    return out
                time.sleep(1)
            return f"({json.dumps(target, ensure_ascii=False)} did not appear within 20 s)\n{out}"
        if action not in ("tap", "long", "type", "key", "scroll"):
            return "error: ui actions are look, tap, long, type, key, scroll, open, wait"
        st = look()  # the screen as it is NOW: what the action will really hit (it may have changed while the model thought)
        leaving = action == "key" and key in ("back", "home")  # always possible: the way out of any screen
        if not leaving and (gate(st, True) or st["root"] is None):
            return gate(st, True) or "error: Android gave no screen content (try ui wait)"
        app = next((x.split("/")[0] for x in (st["pkg"], st["win"], st["focus"]) if x), "?")
        if not leaving and any(UI_SELF.match(x.split("/")[0]) for x in (st["pkg"], st["win"], st["focus"]) if x):
            return ("refused: OPERATOR never acts in Termux, Shizuku or the launcher: their switches decide what it may do. "
                    "ui key home leaves.")
        readable = st["root"] is not None and not gate(st, False)
        els, texts, box, scrolls = ui_elements(st["root"]) if readable else ([], [], (0, 0, 0, 0), False)
        before, note = ui_describe(st, els, texts, scrolls) if readable else None, ""
        if action == "key":
            if key not in UI_KEYS:
                return "error: key is one of " + ", ".join(UI_KEYS)
            cmd = f"input keyevent {UI_KEYS[key]}"
        elif action == "scroll":
            (x1, y1, x2, y2), d = box, {"down": (0, 1), "up": (0, -1), "right": (1, 0), "left": (-1, 0)}.get(key)
            if not d:
                return "error: scroll is down, up, left or right"
            cx, cy, dx, dy = (x1 + x2) // 2, (y1 + y2) // 2, d[0] * (x2 - x1) // 3, d[1] * (y2 - y1) // 3
            cmd = f"input swipe {cx + dx} {cy + dy} {cx - dx} {cy - dy} 300"
        else:
            # several keys in one tap ("1 2 + 3 0 ="): each word must name exactly one element, and the whole target none
            keys = [[e for e in els if e["label"].lower() == k] for k in key.split()] if action == "tap" else []
            if len(keys) > 1 and all(len(k) == 1 for k in keys) and not any(e["label"].lower() == key for e in els):
                labels = " ".join(k[0]["label"] for k in keys)
                if UI_WALLET.search(labels):
                    return "refused: one of these entries leads to the wallet or the Seed Vault. OPERATOR does not open them."
                cls = "system" if UI_DESTRUCTIVE.search(labels) else "payment" if UI_PAYMENT.search(labels) else scope(app)
                no = allow(cls, f'tap "{labels}" in {app}', {"action": "tap", "target": key, "app": app}, {"action": "tap", "target": key})
                if no:
                    return no
                sh("; ".join("input tap %d %d; sleep 0.2" % k[0]["xy"] for k in keys))
                time.sleep(0.8)
                return show(look(), before)
            e = pick(els) if target or action != "type" else next((e for e in els if e["kind"] == "input" and e["focused"]), None)
            if isinstance(e, str):
                return e + "\n" + show(st)
            if e and UI_WALLET.search(e["label"]):
                return "refused: this entry leads to the wallet or the Seed Vault. OPERATOR does not open them: the user does."
            if e and action == "type" and e["kind"] != "input":  # typing would first tap it: a button is tapped by tap only
                return f"error: element {json.dumps(e['label'], ensure_ascii=False)} is not a text field\n" + show(st)
            if e:
                lab, cls = e["label"], scope(app)
                if action != "type" and UI_DESTRUCTIVE.search(lab):
                    cls = "system"
                elif action != "type" and UI_PAYMENT.search(lab):
                    cls = "payment"
                elif action == "type" and conf.get("_tainted") and not e["secret"] and text.strip() not in conf.get("_request", ""):
                    cls = "network"  # after a hostile text, words the owner never gave go into a field: a way out for data
                if e["secret"] and action == "type" and cls != "ordinary" and conf.get("_unattended"):
                    return "refused: a password is typed only in an app the owner allowed (never parked for approval)."
                # an approval covers the element by its label in this app (a number means nothing to another screen)
                covers = {"action": action, "target": lab or target, "text": text, "app": app}
                no = allow(cls, f'{action} "{lab or target}"' + (f' "{text[:60]}"' if action == "type" else "") + f" in {app}",
                           covers, {"action": action, "target": lab or target, "text": text})
                if no:
                    return no
            if action != "type":
                cmd = "input tap %d %d" % e["xy"] if action == "tap" else "input swipe %d %d %d %d 800" % (e["xy"] * 2)
            elif e is None:
                return "error: no text field has the focus: give the field's number in target\n" + show(st)
            elif e["secret"] and (not text.strip() or text.strip() not in conf.get("_request", "")):
                # the owner may dictate a password ("connecte-toi, mdp: ..."); a text the model got anywhere else (a
                # note, a file, a web page, another screen) never goes into a password field
                return ("refused: a password field only takes a password that the user's own request gives, word for word. "
                        "Ask the user to give it, or to type it.")
            else:
                if not e["focused"]:
                    sh("input tap %d %d" % e["xy"])
                    time.sleep(0.7)
                # Android's shell input knows the keys of a plain keyboard only: "é" makes it fail (seen on the Seeker,
                # 13/11). Any other text goes through UiShell, which sets the field's text; without it (an older
                # launcher), the accents are dropped and the model is told
                words = re.sub(r"\s+", " ", text).strip()
                bare = unicodedata.normalize("NFKD", words).encode("ascii", "ignore").decode()
                if e["secret"]:
                    words = text.strip()  # as given, nothing normalised
                    TYPED.add(words)  # kept out of the task's trace, steps and report
                if words.isascii():
                    out = sh("input text " + q(words.replace(" ", "%s")))
                else:
                    out = sh(UI_SHELL + "text %d %d %s%s" % (*e["xy"], q(base64.b64encode(words.encode()).decode()),
                                                              " secret" if e["secret"] else ""))
                    if not out.startswith("exit 0") and bare and not e["secret"]:  # a password is never typed altered
                        out, note = sh("input text " + q(bare.replace(" ", "%s"))), "(typed without accents: no UiShell in the launcher)\n"
                if not out.startswith("exit 0"):
                    return "error: the text could not be typed" + ("" if e["secret"] else f": {out[:200]}")
                cmd = None
        if action in ("key", "scroll") and not leaving:  # checked here, once the key or direction is known to be valid
            # enter presses the focused element: one that deletes or pays is asked like a tap on it (coverage audit 17/11)
            f = next((x["label"] for x in els if x["focused"]), "") if key == "enter" else ""
            cls = "system" if UI_DESTRUCTIVE.search(f) else "payment" if UI_PAYMENT.search(f) else scope(app)
            no = allow(cls, f"{action} {key}" + (f' on "{f}"' if f else "") + f" in {app}", {"action": action, "target": key, "app": app},
                       {"action": action, "target": key})
            if no:
                return no
        if cmd:
            out = sh(cmd)
            if not out.startswith("exit 0"):
                return f"error: {out[:300]}"
        time.sleep(0.8)  # the screen settles
        return note + show(look(), before)

    def t_remember(note):
        note = re.sub(r"\s+", " ", CTRL.sub("", note)).strip()[:300]  # one plain line: a note goes into every later chat
        DATA.mkdir(parents=True, exist_ok=True)
        mem = DATA / "memory.md"
        known = {l.split(" ", 2)[-1].strip().lower() for l in mem.read_text().splitlines()} if mem.exists() else set()
        if note.strip().lower() in known:
            return "already noted"
        with open(mem, "a") as f:
            f.write(f"- {time.strftime('%Y-%m-%d')} {note.strip()}\n")
        return "noted"

    offered = offered_actions(conf)
    s = lambda **p: {"type": "object", "properties": {k: {"type": "string", "description": d} for k, d in p.items()}, "required": list(p)}
    android_schema = {"type": "object", "required": ["action"], "properties": {
        "action": {"type": "string", "enum": offered},
        "text": {"type": "string", "description": "message, or URL for open_url"},
        "title": {"type": "string"}, "number": {"type": "string", "description": "phone number for sms_send"},
        "path": {"type": "string", "description": "file: .apk for install_apk, .png for screenshot"},
        "value": {"type": "string", "description": "milliseconds for vibrate, on/off for torch, permission name for perm_revoke"},
        "package": {"type": "string", "description": "app package for the app_, net_ and perm actions"}}}
    return {
        "read_file": (t_read_file, "Read a text file", s(path="file path")),
        "list_dir": (t_list_dir, "List a directory", s(path="directory path")),
        "search": (t_search, "Find a text or regex in the files of a folder (file:line:text)", s(pattern="text or regex", path="folder")),
        "git": (t_git, "Run git in a repository: status, log, diff, show, add, commit, branch... (no options before the subcommand)",
                s(args="subcommand and its arguments, e.g. 'log --oneline -5'", repo="repository folder")),
        "write_file": (t_write_file, "Create or overwrite a text file", s(path="file path", content="full new content")),
        "shell": (t_shell, "Run a bash command in Termux (git, python, ls...), as the Termux app user, not root", s(command="the command")),
        "python": (t_python, "Run a Python 3 snippet and return what it prints", s(code="python code")),
        "fetch_url": (t_fetch_url, "Download a web page and return its text (uses the network)", s(url="http(s) URL")),
        "android": (t_android, "Phone features: " + ", ".join(offered), android_schema),
        "system": (t_system, "Run an Android shell command with ADB-level rights through Shizuku (pm, settings, dumpsys, getprop...)",
                   s(command="the command")),
        "remember": (t_remember, "Save a short note to long-term memory", s(note="what to remember")),
        # the settings pages are named here: on the phone the model otherwise walks there through the search box
        # (9 actions to turn Bluetooth off on 13/11, where the page is one step away)
        "ui": (t_ui, "See and drive the app on the screen. look gives numbered elements; then tap, long or type by number (or exact "
                     "text; several keys at once: '1 2 + 3'); key back, home, enter; scroll down or up; open an app, or a settings "
                     f"page: 'settings {'|'.join(UI_SETTINGS)}'; wait seconds or a text. One action per call: each returns the new screen.",
               {"type": "object", "required": ["action"], "properties": {
                   "action": {"type": "string", "enum": ["look", "tap", "long", "type", "key", "scroll", "open", "wait"]},
                   "target": {"type": "string", "description": "element number or its text; key; direction; app; seconds"},
                   "text": {"type": "string", "description": "what to type"}}}),
    }


def tool_specs(conf, tools):
    return [{"type": "function", "function": {"name": n, "description": d, "parameters": s}}
            for n, (_, d, s) in tools.items() if (offered_actions(conf) if n == "android" else policy(conf, n) != "off")]


def confirm(prompt, every=False):
    """y/N on the terminal. With every=True, "a" also says yes and returns "all": the caller stops asking for the rest
    of the request (a screen task is many small taps)."""
    sys.stderr.write(f"{prompt} [y/N{'/a = yes to every screen action of this request' if every else ''}] ")
    sys.stderr.flush()
    forced = os.environ.get("SEEKER_AI_CONFIRM")  # scripted runs and tests: yes | no (the question stays in their logs)
    if forced:
        sys.stderr.write(f"{forced} (SEEKER_AI_CONFIRM)\n")
        return forced == "yes"
    try:
        with open("/dev/tty") as tty:
            reply = tty.readline().strip().lower()
            return "all" if every and reply in ("a", "all") else reply in ("y", "yes", "o", "oui")
    except OSError:
        return False


def needs_ok(name, args, conf):
    if name == "write_file" and target(args.get("path", ""), conf).resolve().exists():
        return True  # overwriting is irreversible: always ask (resolved like allowed(): "x/../file" names the file too)
    if policy(conf, name, git_level(args, conf) if name == "git" else args.get("action")) == "auto":
        return False
    if name == "shell":
        cmd = args.get("command", "")
        return not (is_auto_cmd(cmd, conf["shell_auto_allow"]) and paths_ok(cmd, conf))
    if name == "system":
        return not is_auto_cmd(args.get("command", ""), conf["system_auto_allow"])
    return True


def level_of(name, args, conf):
    """read, write, exec or sensitive: what this call can do."""
    if name == "android":
        return ANDROID[args["action"]][1] if args.get("action") in ANDROID else "sensitive"
    if name == "git":
        return git_level(args, conf) or "exec"
    return TOOL_LEVEL.get(name, "sensitive")


def call_tool(name, args, conf, tools):
    stop_check()
    args = {k: v if isinstance(v, str) else json.dumps(v) for k, v in args.items()}  # models also send numbers and lists
    conf["_asked"] = False  # True once the owner approved this very call at the terminal (t_ui reads it)
    if name == "remember" and conf.get("_tainted"):  # a note goes into every later chat: never after a hostile text
        return "refused: no note is kept after a screen, file or page tried to give orders (see the ZION guard)."
    if name == "git" and git_level(args, conf) is None:
        return "error: git takes a subcommand first (" + ", ".join(GIT) + "), with no option before it"
    if name not in tools or policy(conf, name, git_level(args, conf) if name == "git" else args.get("action")) == "off":
        return f"error: {name} {args.get('action', '')} is not available".replace("  ", " ")
    # quotes and backslashes removed first: they cannot hide a package name. Applies even when you approve. Best effort:
    # a command that builds the name from variables or encoded text gets past it, and then only the approval prompt stops it.
    bare = re.sub(r"[\"'\\]", "", args.get("command", "") + args.get("code", ""))
    if name in ("system", "shell", "python") and PROTECTED.search(bare) and CHANGING.search(bare):
        return "refused: the agent may not change Seed Vault or Solana packages"
    # nor what decides over it: zion's commands (a pty can fake their terminal question), its policy, approvals and STOP,
    # in Termux or in the launcher's folder. Best effort like the line above; the owner's approval prompt shows the rest
    if name in ("system", "shell", "python") and ZION_OWN.search(bare):
        return "refused: OPERATOR never runs zion's own commands nor touches its policy, approvals or stop: the owner does"
    # you approve what you see: the whole command, only a file's content is shortened (with a visible mark)
    shown = json.dumps({**args, **({"content": clip(args["content"], 600)} if "content" in args else {})}, ensure_ascii=False)
    n = args.get("target", "").lstrip("#") if name == "ui" else ""
    if n.isdigit() and 1 <= int(n) <= len(conf.get("_ui", {}).get("els") or []):
        shown += " -> " + json.dumps(conf["_ui"]["els"][int(n) - 1]["label"], ensure_ascii=False)  # what number N is
    if conf.get("_unattended"):  # nobody to ask: the owner's policy decides (ui: in t_ui, which knows the app)
        if name != "ui":
            no = permit(conf, action_class(name, args, conf), name, args, f"{name} {plain(shown)}")  # whole: zion shows it
            if no:
                return no
    elif needs_ok(name, args, conf) and not (name == "ui" and conf.get("_ui_ok")):
        warn = " [after a text that gave orders to the AI]" if conf.get("_tainted") else ""
        ok = confirm(f"\n[OPERATOR wants to run]{warn} {name} {plain(shown)}\nallow?", every=name == "ui")
        if not ok:
            return "denied by the user"
        conf["_asked"] = ok is True
        if ok == "all":
            conf["_ui_ok"] = True
    try:
        return clip(str(tools[name][0](**args)), conf["max_tool_output"])
    except (NeedsApproval, Stopped):
        raise
    except Exception as e:  # report to the model instead of crashing the chat
        return f"error: {type(e).__name__}: {e}"


# ---- models and llama-server ----
def models(conf):
    d = Path(conf["models_dir"]).expanduser()
    return sorted(p for p in d.glob("*.gguf") if not p.name.lower().startswith("mmproj")) if d.exists() else []


def find_model(conf, name):
    p = Path(name).expanduser()
    if p.is_file():
        return p.resolve()
    hits = [m for m in models(conf) if name.lower() in m.name.lower()]
    if len(hits) != 1:
        sys.exit(f"model '{name}': " + ("no match" if not hits else "ambiguous: " + ", ".join(h.name for h in hits))
                 + " (see seeker-ai --models)")
    return hits[0]


def get_json(url, timeout=2):
    try:
        with urllib.request.urlopen(url, timeout=timeout) as r:
            return json.loads(r.read() or b"{}")
    except (OSError, ValueError):
        return None


def server_up(url):
    return get_json(url + "/health") is not None


def is_llama_server(cmdline):
    """cmdline = bytes of /proc/PID/cmdline. Termux from Google Play starts every binary through /system/bin/linker64:
    the process is then NAMED linker64 (pgrep -x llama-server finds nothing) and the program is its first two words.
    Only those two are looked at: a script started with `--server .../llama-server` is not a server."""
    return any(os.path.basename(a) == b"llama-server" for a in cmdline.split(b"\0")[:2])


def server_pids():
    pids = []
    for p in PROC.glob("[0-9]*"):
        try:
            if is_llama_server((p / "cmdline").read_bytes()):
                pids.append(int(p.name))
        except OSError:
            pass
    return pids


def serves_port(cmdline, port):
    """cmdline = bytes of /proc/PID/cmdline of a llama-server: was it started with `--port PORT`?"""
    a = cmdline.split(b"\0")
    return any(x == b"--port" and y == port.encode() for x, y in zip(a, a[1:]))


def port_pids(port):
    """llama-servers started for this port, e.g. by OPERATOR in another session and still loading: a 2nd one could not
    bind the port (12/11: it stopped at once and gave the shell back, where the next message read as a command)."""
    out = []
    for p in server_pids():
        try:
            if serves_port((PROC / str(p) / "cmdline").read_bytes(), port):
                out.append(p)
        except OSError:
            pass
    return out


def busy():
    """(PID, message) of the running job that holds the memory (see BUSY), else None. A file whose job is gone is
    removed: its PID could later name another process."""
    try:
        pid, _, why = BUSY.read_text().partition("\n")
        pid = int(pid)
    except (OSError, ValueError):
        return None
    try:
        os.kill(pid, 0)
    except OSError:  # the job ended without removing it (killed with Termux, 12/11 21:08)
        BUSY.unlink(missing_ok=True)
        return None
    return pid, why.strip() or f"a job (pid {pid}) holds the memory, see {tilde(BUSY)}"


def ancestors(pid=None):
    """This process's parent, its parent's parent... (from /proc, up to the first one that cannot be read)."""
    out, pid = [], os.getppid() if pid is None else pid
    while pid > 1 and pid not in out:
        out.append(pid)
        try:
            pid = int((PROC / str(pid) / "stat").read_text().rsplit(")", 1)[1].split()[1])
        except (OSError, ValueError, IndexError):
            break
    return out


def held():
    """The busy job's message, unless this process is one of the job's own steps (the benchmarks start and stop their
    servers through OPERATOR): the launcher, the dashboard and a typed `ai --start` are not, and get the message."""
    b = busy()
    return b[1] if b and b[0] not in ancestors() else None


def pause(why):
    """OPERATOR opened while a job holds the memory: every line gets the job's message, never a shell (12/11: a sentence
    typed at the shell ran as a command). Returns once the job is over, and the chat starts; /exit leaves."""
    print(why)
    while why:
        try:
            line = input("(paused, /exit) > ").strip()
        except (EOFError, KeyboardInterrupt):
            print()
            sys.exit(0)
        if line in ("/exit", "/quit", "exit"):
            sys.exit(0)
        why = held()
        if why:
            print(why)


def stop_server():
    pids = server_pids()
    for sig in (signal.SIGTERM, signal.SIGKILL):
        for p in server_pids():
            try:
                os.kill(p, sig)
            except (ProcessLookupError, PermissionError):
                pass
        for _ in range(20):
            if not server_pids():
                return len(pids)
            time.sleep(0.5)
    return len(pids)


class Waiting:
    """`[label 12s]` on the terminal until stop(): a long wait (model loading, a 1200-token prompt) never looks like a hang."""
    def __init__(self, label):
        self.label, self.t0, self.done = SAY.get(label, label), time.time(), threading.Event()
        self.th = threading.Thread(target=self.tick, daemon=True) if sys.stderr.isatty() else None
        if self.th:
            self.th.start()

    def tick(self):
        while not self.done.wait(1):
            sys.stderr.write(f"\r\033[2m[{self.label} {time.time() - self.t0:.0f}s]\033[0m")
            sys.stderr.flush()

    def stop(self):
        if not self.done.is_set():
            self.done.set()
            if self.th:
                self.th.join()
                sys.stderr.write("\r\033[K")
                sys.stderr.flush()


def ensure_server(conf, model):
    """Returns True when it started llama-server (a cold one: nothing cached yet)."""
    url = conf["server"]
    port = url.rsplit(":", 1)[1]
    if not server_up(url) and port_pids(port):
        w = Waiting("the model is loading (started from another session)")
        try:
            for _ in range(300):
                if server_up(url) or not port_pids(port):
                    break
                time.sleep(1)
        finally:
            w.stop()
    if server_up(url):
        # only a llama-server of this Termux may answer there: Android shows Termux its own processes only, so an app that
        # took the port (Termux killed, phone restarted) has none here. It would get the requests with the tool results,
        # and write the answers and the tool calls (review of 13/11). Nothing but /health and /props went to it.
        if PROC.exists() and not port_pids(port):
            sys.exit(f"127.0.0.1:{port} answers, but no llama-server of OPERATOR listens there: another app holds the port")
        running = (get_json(url + "/props") or {}).get("model_path")
        if not running or Path(running).expanduser().resolve() == model.resolve():
            return False
        sys.stderr.write(f"switching model: {Path(running).name} -> {model.name}\n")
        stop_server()
    if not model.exists():
        sys.exit(f"model not found: {model} (see seeker-ai --models, install-model)")
    log = DATA / "server.log"
    log.parent.mkdir(parents=True, exist_ok=True)
    binary = str(Path(conf["llama_server"]).expanduser()) if "/" in conf["llama_server"] else conf["llama_server"]
    try:
        SLOTS.mkdir(parents=True, exist_ok=True)
        sleep = ["--sleep-idle-seconds", str(conf["sleep_idle_s"])] if conf["sleep_idle_s"] > 0 else []
        p = subprocess.Popen([binary, "-m", str(model), "-c", str(conf["ctx"]), "-t", str(conf["threads"]), "--jinja",
                              "--host", "127.0.0.1", "--port", url.rsplit(":", 1)[1], "--metrics", "--slot-save-path", str(SLOTS),
                              *sleep, *conf["server_args"]],
                             stdout=open(log, "a"), stderr=subprocess.STDOUT, start_new_session=True)
    except OSError as e:
        sys.exit(f"cannot start {binary}: {e} (key llama_server of {tilde(CONF_PATH)})")
    sys.stderr.write(SAY.get("starting", f"starting llama-server with {model.name}") + "\n")
    w = Waiting("loading the model")
    try:
        for _ in range(300):
            if server_up(url):
                return True
            if p.poll() is not None:  # an older llama.cpp (Termux's package) may not know --load-mode or --sleep-idle-seconds
                bad = re.findall(r"(?:invalid|unknown) argument[^\n]*", log.read_text(errors="replace")[-3000:])
                hint = (f": this llama-server is older than OPERATOR expects ({plain(bad[-1].strip())}). Update llama.cpp, or "
                        f'take that option out of {tilde(CONF_PATH)} ("server_args", or "sleep_idle_s": 0)') if bad else ""
                sys.exit(f"llama-server stopped at once (code {p.returncode}), see {tilde(log)}{hint}")
            time.sleep(1)
    finally:
        w.stop()
    sys.exit(f"llama-server did not start, see {log}")


def post_json(url, body, timeout=900):
    req = urllib.request.Request(url, json.dumps(body).encode(), {"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.loads(r.read() or b"{}")


PREFIX_MARK = "ZIONPREFIXMARK7Q"


def prefix_cache(conf, model, head, specs):
    """Have llama-server hold the fixed start of every request (instructions, tool schemas, memory notes): restored from
    disk in 0.2 s when a copy exists for exactly this model, settings and text, else computed once (43 s on the phone)
    and saved. The first answer then starts in about 1 s instead of 44 (tests/phone/probe-slots.json, 12/11).
    Any failure only costs that time: it is reported, never raised."""
    url = conf["server"]
    try:
        st = model.stat()
        key = hashlib.sha256(json.dumps([str(model), st.st_size, int(st.st_mtime), conf["ctx"], conf["server_args"],
                                         conf["thinking"], head, specs], sort_keys=True).encode()).hexdigest()[:16]
        name = f"prefix-{key}.bin"
        if (SLOTS / name).exists():
            try:
                if post_json(f"{url}/slots/0?action=restore", {"filename": name}).get("n_restored"):
                    return "restored"
            except (OSError, ValueError, http.client.HTTPException):
                pass
            (SLOTS / name).unlink(missing_ok=True)  # made by another build or settings: computed again below
        body = {"messages": head + [{"role": "user", "content": PREFIX_MARK}], "chat_template_kwargs": {"enable_thinking": conf["thinking"]}}
        prompt = post_json(f"{url}/apply-template", {**body, **({"tools": specs} if specs else {})})["prompt"]
        post_json(f"{url}/completion", {"prompt": prompt[:prompt.index(PREFIX_MARK)], "n_predict": 0, "cache_prompt": True})
        post_json(f"{url}/slots/0?action=save", {"filename": name})
        for old in sorted(SLOTS.glob("prefix-*.bin"), key=lambda f: f.stat().st_mtime)[:-3]:
            old.unlink()  # the 3 most recent are kept, about 200 MB each
        return "saved"
    except (OSError, ValueError, KeyError, http.client.HTTPException) as e:
        return f"not cached: {e}"


def wake_with_prefix(conf):
    """The server unloaded the model after sleep_idle_s: reload it now with the prefix restored, not recomputed."""
    if conf.get("_prefix") and (get_json(conf["server"] + "/props") or {}).get("is_sleeping"):
        w = Waiting("waking the model")
        try:
            prefix_cache(conf, *conf["_prefix"])
        finally:
            w.stop()


def complete(conf, messages, tools):
    body = {"messages": messages, "stream": True, "chat_template_kwargs": {"enable_thinking": conf["thinking"]}, **conf["sampling"]}
    if conf.get("_remote_model"):
        body["model"] = conf["_remote_model"]
    if tools:
        body["tools"] = tools
    req = urllib.request.Request(conf["server"] + "/v1/chat/completions", json.dumps(body).encode(),
                                 {"Content-Type": "application/json"})
    text, calls, timings, t0, ttft = "", {}, None, time.time(), None
    wait = Waiting("thinking")
    try:
        with urllib.request.urlopen(req, timeout=900) as r:
            for raw in r:
                line = raw.decode().strip()
                if not line.startswith("data: ") or line == "data: [DONE]":
                    continue
                chunk = json.loads(line[6:])
                if chunk.get("error"):
                    raise ServerError(json.dumps(chunk["error"], ensure_ascii=False)[:400])
                timings = chunk.get("timings") or timings
                delta = (chunk.get("choices") or [{}])[0].get("delta") or {}
                if ttft is None and (delta.get("content") or delta.get("reasoning_content") or delta.get("tool_calls")):
                    ttft = time.time() - t0
                    wait.stop()
                if delta.get("reasoning_content"):
                    sys.stdout.write(f"\033[2m{plain(delta['reasoning_content'])}\033[0m")
                if delta.get("content"):
                    text += delta["content"]
                    sys.stdout.write(unstar(conf, plain(delta["content"])) if conf.get("_human") else plain(delta["content"]))
                for tc in delta.get("tool_calls") or []:
                    c = calls.setdefault(tc.get("index", 0), {"id": "", "name": "", "args": ""})
                    f = tc.get("function") or {}
                    c["id"] = tc.get("id") or c["id"]
                    c["name"] += f.get("name") or ""
                    c["args"] += f.get("arguments") or ""
                sys.stdout.flush()
    except urllib.error.HTTPError as e:  # e.g. 400 exceed_context_size_error
        raise ServerError(f"{e.code} {e.read().decode(errors='replace')[:400]}") from None
    except (OSError, http.client.HTTPException) as e:
        raise ServerError(f"llama-server unreachable or connection lost: {e}") from None
    except ValueError as e:  # a cut or garbled stream line (JSON, UTF-8): the answer is lost, the task can go on later
        raise ServerError(f"malformed answer from llama-server: {e}") from None
    finally:
        wait.stop()
        sys.stdout.write(conf.pop("_stars", ""))  # a lone "*" held back at the very end of the answer
    if timings:
        conf["_used"] = sum(timings.get(k) or 0 for k in ("cache_n", "prompt_n", "predicted_n"))  # tokens now in the context
        DATA.mkdir(parents=True, exist_ok=True)
        with open(DATA / "perf.jsonl", "a") as f:
            f.write(json.dumps({"t": time.time(), "model": Path(conf.get("_model", "")).name, "ctx": conf["ctx"],
                                "ttft_s": round(ttft, 2) if ttft else None, **{k: timings.get(k) for k in
                    ("prompt_n", "prompt_ms", "prompt_per_second", "predicted_n", "predicted_ms", "predicted_per_second")}}) + "\n")
        if conf["show_speed"]:
            sys.stderr.write(f"\n\033[2m[{timings.get('predicted_per_second', 0):.1f} tok/s, {timings.get('predicted_n')} tokens; "
                             f"prompt {timings.get('prompt_n')} tok at {timings.get('prompt_per_second', 0):.1f} tok/s; "
                             f"first token {ttft or 0:.1f}s]\033[0m")
    return text, [calls[i] for i in sorted(calls)]


def unstar(conf, piece):
    """Markdown bold (**) is noise on a phone screen: dropped, even when the two stars come in two pieces of the stream
    (the trailing stars of a piece wait for the next one)."""
    s = (conf.pop("_stars", "") + piece).replace("**", "")
    keep = len(s.rstrip("*"))
    conf["_stars"] = s[keep:]
    return s[:keep]


def forget_oldest(conf, messages):
    """Context nearly full: drop the older half of the exchanges, never the system prompt, the memory notes nor the
    current request. One big cut, not one per turn: everything after it is processed again (about a minute here)."""
    start = 3 if messages[1:3] and messages[1]["content"].startswith(NOTES) else 1  # the notes pair stays
    users = [i for i in range(start + 1, len(messages)) if messages[i]["role"] == "user"]
    if not users:
        return False
    del messages[start:users[(len(users) - 1) // 2]]
    sys.stderr.write("\033[2m[context nearly full: the oldest exchanges are forgotten]\033[0m\n")
    return True


def shrink_results(messages, size=200):
    """Context nearly full inside one long request (a screen task reads a screen per step): every tool result but the
    last is cut to its first lines. The model has read them and answered since; forget_oldest could cut nothing here,
    there is a single request. One cut for all, as there: what follows is processed again once."""
    old = [m for m in [m for m in messages if m.get("role") == "tool"][:-1] if len(m["content"]) > size + 80]
    for m in old:
        m["content"] = m["content"][:size] + f"\n[... {len(m['content']) - size} more characters, dropped to free the context]"
    if old:
        sys.stderr.write("\033[2m[context nearly full: older tool results are shortened]\033[0m\n")
    return bool(old)


def turn(conf, messages, tool_specs_, tools, save=None):
    """One request: model answers, tools run, until a plain answer. save() runs after every tool round, so a task
    interrupted by Android (Termux killed for memory) keeps its progress in the session file."""
    used, seen, loops = [], {}, 0  # seen: call -> [times it gave the same result in a row, that result]
    conf.pop("_ui_ok", None)  # "yes to every screen action" was said for the request before
    # the owner's own words for this request, the only source of a password that may be typed (see t_ui). The caller
    # gives them when the request also carries other text: an attached file, piped input, a task's plan and step results
    # (written by the model from what it read). Otherwise: the last user message.
    said = conf.pop("_said", None)
    conf["_request"] = said if said is not None else next(
        (str(m.get("content") or "") for m in reversed(messages) if m.get("role") == "user"), "")
    warm = conf.pop("_warm", None)
    if warm and warm.is_alive():  # the prefix is still being prepared: wait (the request would wait in the server anyway)
        w = Waiting("preparing OPERATOR, first time only")
        warm.join()
        w.stop()
    wake_with_prefix(conf)
    for _ in range(MAX_ROUNDS):
        stop_check()
        if time.time() > conf.get("_deadline", float("inf")):  # a task step's time is up (zion's limits)
            messages.append({"role": "assistant", "content": "FAILED: the time limit of this step was reached"})
            print("\n[time limit reached]")
            return used
        if conf.get("_used", 0) > 0.75 * conf["ctx"] and (shrink_results(messages) or forget_oldest(conf, messages)):
            conf["_used"] = 0
        while True:
            try:
                text, calls = complete(conf, messages, tool_specs_)
                break
            except ServerError as e:  # the request itself is larger than the context: forget more, or give up
                if "context" not in str(e) or not (shrink_results(messages) or forget_oldest(conf, messages)):
                    raise
        msg = {"role": "assistant", "content": text}
        if calls:
            msg["tool_calls"] = [{"id": c["id"] or f"call{i}", "type": "function",
                                  "function": {"name": c["name"], "arguments": c["args"] or "{}"}} for i, c in enumerate(calls)]
        messages.append(msg)
        if not calls:
            print()
            return used
        denied = False
        for tc in msg["tool_calls"]:
            try:
                args = json.loads(tc["function"]["arguments"])
            except json.JSONDecodeError:
                args = None
            name = tc["function"]["name"]
            key = (name, tc["function"]["arguments"])
            if denied:  # the user refused an earlier call of this answer: the calls after it do not run either
                out = "not run: the user refused an earlier action of this request"
            elif seen.get(key, [0])[0] >= 2:  # a small model repeats a step that brings nothing new: said as a fact, once
                loops += 1
                out = "not run: this same call already gave the same result twice in this request."
            else:
                out = call_tool(name, args, conf, tools) if isinstance(args, dict) else "error: arguments are not valid JSON"
                out = guard(name, out, conf)
                seen[key] = [seen[key][0] + 1, out] if key in seen and seen[key][1] == out else [1, out]
                if "_trace" in conf:  # a task keeps what each tool really answered, for its report (never a password)
                    conf["_trace"].append({"tool": name, "args": untyped(tc["function"]["arguments"])[:300], "out": untyped(out)[:400]})
            # the model chose the name and the action: plain() before the terminal and the history see them
            label = plain(str(name))[:60] + (f":{plain(str(args['action']))[:40]}" if isinstance(args, dict) and args.get("action") else "")
            used.append(label)
            if conf.get("_human"):  # what it did, not its raw output: the answer that follows says what it found
                sys.stderr.write(f"\033[2m({label})\033[0m\n")
                if conf.get("_serve") and isinstance(args, dict) and level_of(name, args, conf) != "read" and not \
                        out.startswith(("error", "denied", "not run", "refused")):
                    print(f"({label})")  # the launcher's screen keeps a trace of what changed something (review of 13/11)
            else:  # the call's own arguments too: a log must say what was tapped, not only what came back
                what = plain(untyped(" ".join(str(v) for k, v in args.items() if k != "action"))[:60]) if isinstance(args, dict) and name == "ui" else ""
                sys.stderr.write(f"\033[2m[step {len(used)} {label}{' ' + what if what else ''}] {plain(out[:200])}\033[0m\n")
            if out == "denied by the user":
                denied = True
                out += ": NOT done. Do not try again, nor another way; tell the user it was not done."
            messages.append({"role": "tool", "tool_call_id": tc["id"], "content": out})
        if save:
            save()
        if denied or loops >= 2:  # the user said no, or the model goes round in circles: one last answer without
            text, _ = complete(conf, messages, [])  # tools, so it cannot ask again (after a refusal it did, 12 times)
            messages.append({"role": "assistant", "content": text})
            print()
            return used
    # said as the last answer: a task step that ran out of rounds is a failure, not the last tool output (audit 17/11)
    messages.append({"role": "assistant", "content": f"FAILED: stopped after {MAX_ROUNDS} tool rounds"})
    print(f"\n[stopped after {MAX_ROUNDS} tool rounds]")
    return used


def system_text(conf, agent):
    f = CONF_PATH.parent / "system.md"
    if f.exists():
        return f.read_text()
    return (conf["system_prompt"] or (SYSTEM_AGENT.format(workdir=tilde(Path(conf["workdir"]).expanduser())) if agent else SYSTEM_CHAT)) \
        + (HUMAN if conf.get("_human") else "")


NOTES = "Notes kept (local memory):"
NOTES_ACK = "Noted. I answer each request in its own language, whatever the language of these notes."  # an English question got a French answer after French notes, in chat mode (12/11)


def notes_pair(conf):
    """The memory notes as an exchange of their own, before the conversation: inside the request they set its language
    (French notes made the model answer an English question in French, on the phone, 12/11)."""
    text = memory_notes(conf)
    return [{"role": "user", "content": text.strip()}, {"role": "assistant", "content": NOTES_ACK}] if text else []


def memory_notes(conf):
    # Goes in the first user message, not the system prompt: the system prompt + tools prefix (~1200 tokens, minutes
    # of prompt processing on this phone) then stays identical between calls and llama-server reuses its cache.
    mem = DATA / "memory.md"
    notes = mem.read_text()[-conf["memory_chars"]:] if mem.exists() else ""
    return f"{NOTES}\n{notes}\n\n" if notes else ""


def attach(paths, conf):
    return "\n".join(f'<file path="{p}">\n{allowed(p, conf).read_text(errors="replace")}\n</file>' for p in paths)


def log_task(mode, prompt, used, error=None):
    DATA.mkdir(parents=True, exist_ok=True)
    with open(DATA / "history.jsonl", "a") as f:
        f.write(json.dumps({"t": time.strftime("%Y-%m-%d %H:%M:%S"), "mode": mode, "prompt": secretless(prompt)[:200],
                            "tools": used, "error": error}, ensure_ascii=False) + "\n")


def save_session(path, messages):
    if not any(m.get("role") == "user" and not str(m.get("content") or "").startswith(NOTES) for m in messages[1:]):
        return  # nothing asked yet (Ctrl+C on the first request): --resume must not pick an empty chat
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(json.dumps(messages[1:], ensure_ascii=False))
    os.replace(tmp, path)  # never half a file, even if Android kills Termux while it writes


def load_session(path):
    """The saved messages, or None if the file is unreadable or not a chat."""
    try:
        msgs = json.loads(path.read_text())
    except (OSError, ValueError):
        return None
    ok = isinstance(msgs, list) and all(isinstance(m, dict) and isinstance(m.get("role"), str) for m in msgs)
    return msgs if ok else None


