def policy(conf, name, action=None):
    if name == "android":
        if action not in ANDROID or action not in conf["android_actions"]:
            return "off"
        level = conf["android_policy"].get(action) or conf["levels"][ANDROID[action][1]]
        whole = conf["tools"].get("android")  # ask or off for the whole tool can only tighten an action, never reopen it
        return "off" if "off" in (level, whole) else "ask" if whole == "ask" else level
    if name == "git" and action in conf["levels"]:  # the level of this git subcommand (git_level)
        return conf["tools"].get("git") or conf["levels"][action]
    return conf["tools"].get(name) or conf["levels"][TOOL_LEVEL[name]]


def git_level(args, conf):
    """read, exec or sensitive for this git call; None if not offered (unknown subcommand, options before it)."""
    try:
        words = shlex.split(args.get("args", ""))
    except ValueError:
        return None
    if not words or words[0] not in GIT:
        return None
    level, rest = GIT[words[0]], words[1:]
    if level == "read":
        listing = {"-a", "-r", "-v", "-vv", "--list", "--all", "--remotes", "--show-current"}
        if (words[0] == "branch" and not set(rest) <= listing) or any(
                w.startswith(("--output", "--ext-diff", "--textconv", "--exec", "-O", "--open-files")) for w in rest):
            return "exec"
        try:  # a repository whose config can start programs is never looked at without asking
            root = allowed(args.get("repo") or ".", conf)
            cfg = root / ".git" / "config"
            if cfg.exists() and GIT_RISKY.search(cfg.read_text(errors="replace")):
                return "exec"
        except (OSError, PermissionError):
            return "exec"
        if any(git_path_risky(w, root) for w in rest):
            return "exec"
    return level


def git_path_risky(word, root):
    """True if a git read argument reaches past the repository: `git diff /dev/null ~/.ssh/id_ed25519` reads any file
    (a path outside the work tree turns diff into --no-index), and `git show HEAD:.env` prints a hidden file."""
    if word.startswith("--no-index"):
        return True
    if word.startswith("-") or word == "--":
        return False
    path = word.split(":", 1)[1] if ":" in word else word  # rev:path names a path too
    if any(part.startswith(".") and part not in (".", "..") for part in Path(path).parts):
        return True
    p = Path(path).expanduser() if path.startswith(("~", "/")) else root / path
    if "/" not in path and not path.startswith("~") and not p.exists():
        return False  # a revision (HEAD~1, main) or a pattern, not a path
    p, r = p.resolve(), root.resolve()
    return p != r and r not in p.parents


def offered_actions(conf):
    return [k for k in conf["android_actions"] if policy(conf, "android", k) != "off"]


